# d�penses des m�nages en transport (retrait de la d�duction de la subvention puisqu'elle est versee ensuite dans le RDB)
@over EXP_MOBAUTO_Val[h,ecl] = ( @year > %baseyear ) * (DEBT_AUTO_Val[h,ecl]{-1} * ( R_I_AUTO[h,ecl]{-1} + R_RMBS_AUTO[h,ecl]{-1} ) +  R_CASH_AUTO[h,ecl] * PNewAUTO[h,ecl] * NewAUTO[h,ecl] +  PEXP_AUTO[h,ecl] * EXP_AUTO[h,ecl] ) +  ( @year <= %baseyear ) * (EXP_MOBAUTO_Val[h,ecl]{-1} * ( 1 + STEADYSTATE(1,1) ) )

# dette pour financer l'achat de v�hicule (retrait de la d�duction de la subvention puisqu'elle est versee ensuite dans le RDB) 
#@over DEBT_auto_Val[h,ecl] = (@year > %baseyear)*( DEBT_auto_Val[h,ecl]{-1}*(1 - R_RMBS_AUTO[h,ecl])   + R_LOAN_AUTO[h,ecl]*PNewAuto[h,ecl]*NewAuto[h,ecl] )    + (@year <= %baseyear)*(DEBT_auto_Val[h,ecl]{-1}*(1 + STEADYSTATE(1,1)))
# je d�sactive apres echange avec Gael

# pond�ration des co�ts d'usage par classe par les parts des classes (phi_elec) en t-1 et non plus en 2006
@over UC_auto_elec[h] = sum(phi_elec[h,pcl]{-1}* (UC_K_auto_elec[h,pcl] + UC_E_auto_elec[h,pcl]) on pcl) + UC_M_auto_elec[h] 
@over UC_auto_th[h] = sum(phi_th[h,ecl]{-1}* (UC_K_auto_th[h,ecl] + UC_E_auto_th[h,ecl]) on ecl) + UC_M_auto_th[h]
# change tr�s peu

### REMARQUE: comme pour le bloc logement, le prix de production du secteur auto (construction) ne tient pas compte des effets de structure de sa production qui �volue avec les pref des consommateur. La distinction entre types de VP n'existant pas du c�t� de l'offre. Manque de coh�rence pour ces secteurs entre prix des blocs hybrides et prix de production.

# Retrait des chocs de productivit� introduits pendant la mission JPF/SM pour �viter que la hausse de demande d'automobiles induite par l'effet de composition (prix des VE > prix des VT, enti�rement comptabilis� en volume) ne conduise � des cr�ations d'emplois. Mais ces chocs de productivit� positifs g�n�raient une baisse des co�ts unitaires. A noter que CH_03 ne repr�sente que 5% de QD_03. 
@over PROG_L_03  = PROG_L_03{-1}  * ( 1  + GR_PROG_L_03  + CHOC_L  + CHOC_PGF )
# idem capital (pour �viter hausse de l'invt) -> ne tourne plus...
@over PROG_K_03  = PROG_K_03{-1}  * ( 1  + GR_PROG_K_03  + CHOC_K  + CHOC_PGF )

# Alternative : corriger les �quations d'investissement, de demande de travail, de demande de CI, sans affecter les co�ts unitaires
# variable de production ne tenant pas compte de l'effet qualite (QD utilis�e en proxy pour corriger plus facilement de l'effet qualit�), utilis�e qu'en dlog (ne pas regarder le niveau)
d(log(Y_03_corr)) = (1-VT_AMS) * d(log(Y_03))+ (VT_AMS)*((@year >=2024)*(@year <=2035)*d(log(QD_03 - CHD_03 + (NewAUTO_H01*@elem(pnewauto_H01, %baseyear) +  EXP_03_OTH_val_H01/PCH_03)*CHD_03/CH_03 ))+(@year > 2035)*d(log(Y_03)))

# demande de travail
@over d(log(L_des_03))  = 0.2  * d(log(L_des_03{-1}))  + 0.49  * d(log(Y_03_corr))  - 0.5  * d(log(CL_03  * PROG_L_03  / PY_03))  - 0.64  * ( log(L_des_03{-1})  - log(L_n_03{-1}) )
@over d(log(L_n_03)) = d(log(Y_03_corr)) - d(log(PROG_L_03))  + d(SUBST_L_03)

# Investissement
@over d(log(IA_n_des_03))  = d(IMP_BUD_niv_bis_03)  + ( ADJUST(1  , 1)  * dlog(IA_n_des_03{-1})  + 1.8  * dlog(Y_03_corr)  + 0.28  * ( log(IA_notionnel_03{-1})  + IMP_BUD_niv_bis_03{-1}  - log(IA_n_des_03{-1}) )  + ADJUST(1  , 4)  * 0  * d(SUBST_K_03) )
@over d(log(IA_notionnel_noshock_03))  = dlog(Y_03_corr)  + d(SUBST_K_03)  - dlog(PROG_K_03)

# demande de CI
@over d(log(MAT_n[cm1,s]))  = ( @year <= 2019 )  * ( dlog(CIexo[cm1,s]) )  + ( 1  - choc_tech_coef )  * ( @year > 2019 )  * ( dlog(Y_03_corr)  + ( @year > 2023 )  * ( @year <= 2030 )  * ( Tech_coef_var[cm1,s]  - d(SUBST_MAT_03) )  + ( @year > 2030 )  * ( Tech_coef_var_2[cm1,s]  - d(SUBST_MAT_03) )  + d(SUBST_MAT_03) )  + ( choc_tech_coef )  * ( @year > 2019 )  * ( dlog(Y_03_corr)  + ( @year > 2023 )  * ( @year <= 2030 )  * ( Tech_coef_var_ams[cm1,s]  - d(SUBST_MAT_03) )  + ( @year > 2030 )  * ( Tech_coef_var_ams2[cm1,s]  - d(SUBST_MAT_03) )  + d(SUBST_MAT_03) ) where s in 03
@over d(log(E_oth_n_03))  = d(log(Y_03_corr))  + d(SUBST_E_03)  - d(log(PROG_E_03))
 
# calcul des taux de subventions agr�g�s sur les d�penses en valeur et non pas le nombre de v�hicules
@over R_SUB_AUTO_H01_CA  * NewAUTO_H01_CA * PNewAUTO_H01_CA    = ( R_SUB_AUTO_elec_H01  * NewAUTO_elec_H01*PAUTO_elec_H01  + R_SUB_AUTO_th_H01_CA  * NewAUTO_th_H01_CA* PNewAUTO_th_H01_CA ) 
@over R_SUB_AUTO_elec_H01 = sum(R_SUB_AUTO_elec[h,pcl]*NewAUTO_elec[h,pcl]*PAUTO_elec[h,pcl]/(NewAUTO_elec[h]*PAUTO_elec[h]) on pcl)
@over R_SUB_AUTO_H01 = R_SUB_AUTO_th_H01 * (NewAUTO_th_H01* PNewAUTO_th_H01)/(NewAUTO_H01* PNewAUTO_H01) + R_SUB_AUTO_elec_H01 * (NewAUTO_elec_H01*PAUTO_elec_H01)/(NewAUTO_H01* PNewAUTO_H01)
@over R_SUB_AUTO_th_H01 * NewAUTO_th_H01 * PNewAUTO_th_H01  = sum (R_SUB_AUTO_th[h,ecl] * NewAUTO_th[h,ecl] * PNewAUTO_th[h,ecl] on ecl)

# alignement du calcul des d�penses de VT sur celles des VE (prise en compte du nbe de km / auto)
@over dlog(EXP_AUTO[h,ecl,ce2]) = d(log(AUTO_th[h,ecl,ce2])) + dlog(KmPerAuto[h]) - dlog(PROG_AUTO) - dlog(sobre_AUTO)  if AUTO_th[h,ecl,ce2] <> 0   

# rmq: la subvention par VE achet� est inf�rieure dans l'AMS � celle de l'AME apr�s 2025 (� corriger pour run3?)
# @over bonus_elec_H01  = R_bonus_elec
 #+ ( 1  - AME_Bonus_elec )  * ( ( @year <= 2023 )  * R_bonus_elec  + ( @year > 2023 )  * ( @year <= 2030 )  * ( SUB_AUTO_elec  * PGDP  / ( NewAUTO_elec_H01  * @elem(PGDP , 2023) ) )  + ( @year > 2030 )  * ( bonus_elec_H01{-1} ) )

# Baisse du surcout VE vs VT 
@over PAUTO_elec[h,pcl] = PNewAUTO_th[h,pcl] + surcout_elec/1000

