#conso des m�nages
	#dai
 d(log(CHM_des_n[cdai])) = 1.55*dlog(QD[cdai]) - 0.41*(log(CHM_des_n[cdai]{-1}) - log(EXP[cdai]{-1}) + 0.48*(log(PCHM[cdai]{-1})-log(PCHD[cdai]{-1}))) if CHM[cdai] <> 0
 
#@over d(log(CHM_des_n_03)) = d(log(CHM_03)) * (@year<=2019) + (1.55*dlog(QD_03) - 0.41*(log(CHM_des_n_03{-1}) - log(EXP_03{-1}) + 0.48*(log(PCHM_03{-1})-log(PCHD_03{-1})))) * (@year>2019) if CHM_03 <> 0
# 
#@over d(log(CHM_des_n_03)) = d(log(CHM_03)) * (@year<=2019) + (1*dlog(Q_03) + 0.48*(log(PCHM_03{-1})-log(PCHD_03{-1}))) * (@year>2019) if CHM_03 <> 0
# 
 #@over CHM_des_n_03 = (CHM_03) * (@year<=2019) + (CHM_des_n_03{-1}* (1 + dlog(Q_03) + 0.48*(log(PCHM_03{-1})-log(PCHD_03{-1})))) * (@year>2019) if CHM_03 <> 0
 
 CHM_des[cdai] = CHM_des[cdai]{-1}*((1 + (QMexo[cdai]>0)*(d(QMexo[cdai])/QMexo[cdai]{-1})))*(@year<=2019) _
                        + ((CHM_des[cdai]{-1}*(1+d(CHM_des_n[cdai])/CHM_des_n[cdai]{-1})>0)*(CHM_des[cdai]{-1}*(1+d(CHM_des_n[cdai])/CHM_des_n[cdai]{-1}))+(CHM_des[cdai]{-1}*(1+d(CHM_des_n[cdai])/CHM_des_n[cdai]{-1})<=0)*0.00001)*(@year>2019) if CHM[cdai] <> 0
                        
@over CHM_des_03  = (QMexo_03/(QDexo_03+QMexo_03)*EXP_03)*(@year<=2019) + ( ( CHM_des_03(-1)  * ( 1  + d(CHM_des_n_03)  / CHM_des_n_03(-1) ) > 0 )  * ( CHM_des_03(-1)  * ( 1  + d(CHM_des_n_03)  / CHM_des_n_03(-1) ) )  + ( CHM_des_03(-1)  * ( 1  + d(CHM_des_n_03)  / CHM_des_n_03(-1) ) <= 0 )  * 0.00001 )  * ( @year > 2019 ) 

# cette correction est nécessaire car EXPexo_03 évolue comme le nombre d'automobiles et non comme l'évolution du CA du secteur en € constant sur la période 2006-2019, contrairement au QM_exo. QMexo augmente beaucoup plus vite que le nombre de véhicules, si bien que sans correction la production domestique tendrait vers zéro en 2020.   
  
                        
 @over CHM[cdai] = CHM[cdai]{-1}*((1 + (QMexo[cdai]>0)*(d(QMexo[cdai])/QMexo[cdai]{-1})))*(@year<=2019) _
                        + ((EXP[cdai] - CHM_des[cdai]>0)*(CHM_des[cdai])+(EXP[cdai] - CHM_des[cdai]<=0)*(EXP[cdai] -0.00001))*(@year>2019) if CHM[cdai] <> 0
                        
@over CHM_03 = (QMexo_03/(QDexo_03+QMexo_03)*EXP_03)*(@year<=2019) + ((EXP_03 - CHM_des_03>0)*(CHM_des_03)+(EXP_03 - CHM_des_03<=0)*(EXP_03 -0.00001))*(@year>2019) if CHM_03 <> 0 # cette correction est nécessaire car EXPexo_03 évolue comme le nombre d'automobiles et non comme l'évolution du CA du secteur en € constant sur la période 2006-2019, contrairement au QM_exo. QMexo augmente beaucoup plus vite que le nombre de véhicules, si bien que sans correction la production domestique tendrait vers zéro en 2020.   
  
 @over CHD[cdai]  = ((EXP[cdai]-CHM[cdai] > 0) * (EXP[cdai] - CHM[cdai]) + (EXP[cdai] - CHM[cdai] =< 0) * (0.00001))*(@year<=2019) _
                    + ((EXP[cdai] - CHM[cdai]>0)*(EXP[cdai] - CHM[cdai])+(EXP[cdai] - CHM[cdai]<=0)*0.00001)*(@year>2019)

 CH_bis_dgt[cdai] = CHD[cdai] + CHM[cdai]
 verif_CH_dgt[cdai] = EXP[cdai] - CH_bis_dgt[cdai]

