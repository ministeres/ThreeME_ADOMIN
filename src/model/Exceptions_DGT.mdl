          @over PK_NE[sne] * K_NE[sne] = ( 1 - Tdec[sne] ) * PK_NE[sne]{-1} * K_NE[sne]{-1} + PIA[sne] * I_NE[sne] if K_NE[sne] > 0 
   
          @over CK_E[sne] = PK_E[sne] * (  R[sne] - d(P)/P{-1} + Tdec[sne] + R_PREMIUM ) if K[sne] > 0
   
          @over CK_NE[sne] = PK_NE[sne] * (  R[sne] - d(P)/P{-1} + Tdec[sne] + R_PREMIUM ) if K[sne] > 0 
    
          @over CK[sne] = (CK_E[sne]*K_E[sne] + CK_NE[sne]*K_NE[sne])/K[sne] if K[sne] > 0  #where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 14 15 16 17 18 
   
