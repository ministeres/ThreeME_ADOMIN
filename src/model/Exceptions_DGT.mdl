 IA_bis_dgt[cservex,sne] = IAD[cservex,sne] + IAM[cservex,sne]
 verif_IA_dgt[cservex,sne] = IA_n[cservex,sne] - IA_bis_dgt[cservex,sne]

	#�nergies
#Il n y a pas d importations d investissements �nerg�tiques
####equilibre comptable OK

#### TAUX DE MARGE DES SECTEURS NON ENERGETIQUES ####

# Utilisation de la d�finition du taux de marge de la V3 pour tous les secteurs non-�nerg�tiques

##! Cost share of input $f$ for sector $s$
phi_n_K[sne] = K_n[sne] * CK[sne] / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne])
phi_n_L[sne] = L_n[sne] * PROG_L[sne] * CL[sne] / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne])
phi_n_E[sne] = (E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne])) / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne])
phi_n_MAT[sne] = MAT_n[sne] * PMAT[sne] / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne])

##! Capacit� de production (fonction de production �valu�e aux quantit�s effectives de facteurs, comme dans la V3)
d(log(YCAP[sne])) = phi_n_L[sne]{-1} * d(log(L[sne] * PROG_L[sne]) ) + phi_n_K[sne]{-1} * d(log(K[sne] * PROG_K[sne]) ) + phi_n_E[sne]{-1} * d(log(E[sne] * PROG_E[sne]) ) + phi_n_MAT[sne]{-1} * d(log(MAT[sne]) ) if YCAP[sne] <> 0

CUR_bis[sne] = Y[sne]/YCAP[sne]

d(log(CUR_test[sne])) = 0.6 * d(log(CUR_bis[sne])) + 0.4 * d(log(CUR_cible[sne])) - 0.6 * (log(CUR_test[sne]{-1}) - log(CUR_cible[sne]{-1}))

@over dlog(1+TMD_n[sne]) = (0.4 * ( dlog(Y[sne]) -dlog(Y_e[sne]{-1})))*(@year<=2019) + ((TMD_n[sne]{-1}>0.01)*(0.75 * d(log(CUR_test[sne]))) + (TMD_n[sne]{-1}<=0.01)*(0.000001)) * (@year > 2019) if Y[sne] > 0

#agr�g� sne
YCAP = sum(YCAP[sne] on sne)
CUR_bis = Y/YCAP
d(log(CUR_test)) = 0.6 * d(log(CUR_bis)) + 0.4 * d(log(CUR_cible)) - 0.6 * (log(CUR_test{-1}) - log(CUR_cible{-1}))						


#### MODIFICATION DES EQUATIONS DE SALAIRES ####

# salaires notionnels - secteurs non �nerg�tiques : terme chomage en contemporain

d(log(W_S_des_n[sne])) = 1*d(log(PVA)) + 1*d(log(PROG_L[sne])) + 1*d(log(1/((1-TCSS)*(1-TIR[H01]{-1})))) - 3.6*d(UnR_TOT)      if W_S_n[sne] <> 0

@over d(log(W_S_n[sne])) = (@year<=2019)* (1*d(log(P_e)) + d(log(CFS)) + 1*d(log(PROG_L[sne])) - 1.8*d(UnR_TOT{-1})) + (@year>2019)* d(log(W_S_des_n[sne]))

@over d(log(W_S_n_13))  = (@year<=2019)*(1  * d(log(P_e))  + d(log(CFS))  + 1  * d(log(PROG_L_13))  - 1.8  * (  - d(L_13{-1}  * ( DLog(GDP_13)  - Dlog(prog_L_13) )  / ( L_13{-1}  / L{-1}  * POP_tot{-1} )) ))+ (@year>2019)* d(log(W_S_des_n_13))

#@over d(log(W_S_n[sne])) = 1*d(log(PVA)) + 1*d(log(PROG_L[sne])) + 1*d(log(1/((1-TCSS)*(1-TIR[H01]{-1})))) - 3.6*d(UnR_TOT)      if W_S_n[sne] <> 0


# salaires de CT - secteurs non �nerg�tiques

d(log(W_S_ademe[sne]))  = (ADJUST(18 , 1) * d(log(W_S_n[sne])) + ( 1 - ADJUST(18 , 1) ) * d(log(W_S[sne]{-1})) - ADJUST(18 , 2) * (log(W_S[sne]{-1}/W_S_n[sne]{-1})))

d(log(W_S_dgt[sne]))  = ( 0.5 * d(log(P)) + 0.5 * d(log(P{-1})) + 0.42 * d(log(Y[sne]/L[sne])) - 0.7 * d(UnR_TOT) - 0.27 * (log((W_S[sne]{-1})/W_S_n[sne]{-1})))

@over d(log(W_S[sne]))  =  d(log(W_S_ademe[sne])) * (@year <= 2019) + d(log(W_S_dgt[sne]))* (@year > 2019) # calibrage sur l'�quation des salaires des travailleurs qualifi�s (la valeur des coefficients �tant de toute fa�on proche de celle des travailleurs non-qualifi�s)

#@over d(log(W_S[sne]))  = (ADJUST(18 , 1) * d(log(W_S_n[sne])) + ( 1 - ADJUST(18 , 1) ) * d(log(W_S[sne]{-1})) - ADJUST(18 , 2) * (log(W_S[sne]{-1}/W_S_n[sne]{-1}))) * (@year <= 2019) + ( 0.5 * d(log(P)) + 0.5 * d(log(P{-1})) + 0.42 * d(log(Y[sne]/L[sne])) - 0.7 * d(UnR_TOT) - 0.27 * (log((W_S[sne]{-1})/W_S_n[sne]{-1})))* (@year > 2019) # calibrage sur l'�quation des salaires des travailleurs qualifi�s (la valeur des coefficients �tant de toute fa�on proche de celle des travailleurs non-qualifi�s)


# salaires de CT - secteurs �nerg�tiques

d(log(W_S_ademe[se]))  = (ADJUST(18 , 1) * d(log(W_S_n[se])) + ( 1 - ADJUST(18 , 1) ) * d(log(W_S[se]{-1})) - ADJUST(18 , 2) * (log(W_S[se]{-1}/W_S_n[se]{-1})))

d(log(W_S_dgt[se]))  = (1 * d(log(P)) + 0.42 * d(log(PROG_L[se])) - 0.7 * d(UnR_TOT) - 0.27 * (log((W_S[se]{-1})/W_S_n[se]{-1})))

@over d(log(W_S[se]))  = d(log(W_S_ademe[se]))* (@year <= 2019) + d(log(W_S_dgt[se]))* (@year > 2019) # calibrage sur l'�quation des salaires des travailleurs qualifi�s (la valeur des coefficients �tant de toute fa�on proche de celle des travailleurs non-qualifi�s)


#### MODIFICATION PRIX DE PRODUCTION ####


d(log(PY_des[sdai])) = 0.66 * d(log(NCU_n[sdai])) + 0.07 * d(log(1 + TMD_n[sdai])) - 0.17 * (log(PY_des[sdai]{-1}) - log(PY_n[sdai]{-1}))
d(log(PY_des[sdse])) = 0.49 * d(log(NCU_n[sdse])) + 0.11 * d(log(1 + TMD_n[sdse])) + 0.19 * d(log(NCU_n[sdse]{-1})) - 0.09 * (log(PY_des[sdse]{-1}) - log(PY_n[sdse]{-1}))
d(log(PY_des[sdsa])) = 0.36 * d(log(PY_des[sdsa]{-1})) + 0.11 * d(log(NCU_n[sdsa])) + 0.16 * d(log(1 + TMD_n[sdsa])) - 0.06 * (log(PY_des[sdsa]{-1}) - log(PY_n[sdsa]{-1}))
d(log(PY_des[se])) = 0.70 * d(log(NCU_n[se])) - 0.26 * (log(PY_des[se]{-1}) - log(PY_n[se]{-1}))

@over log(PY[s]) = (@year <= 2019) * (ADJUST(17, 1) * log(PY_n[s]) + (1 - ADJUST(17, 1)) * (log(PY[s]{-1}) + d(log(PY_e[s])))) + (@year > 2019) * ( log(PY[s]{-1}) + d(log(PY_des[s])))


#### MODIFICATION DYNAMIQUE DEMANDE DE TRAVAIL ####

d(log(L_des[sne])) = 0.20 * d(log(L_des[sne]{-1})) + 0.49 * d(log(Y[sne])) - 0.5 * d(log(CL[sne]*PROG_L[sne]/PY[sne])) - 0.64 *(log(L_des[sne]{-1})-log(L_n[sne]{-1}))
@over log(|V|[sne]) = (@year<= 2019) * (ADJUST(1 + $V, 1) * log(|V|_n[sne]) + (1 - ADJUST(1 + $V, 1)) * (log(|V|[sne]{-1}) + d(log(|V|_e[sne])))) + (@year > 2019) *( log(|V|[sne]{-1}) + d(log(L_des[sne])) ) if |V|[sne] <> 0 where V in L

#### MODIFICATION DYNAMIQUE CONSOMMATION ####

d(log(EXP_des[co,h])) = 0.75 * d(log(ARBINC_VAL[h]/P)) - 0.5 * d(R  - infl_FR) - 0.26 * d(UnR_TOT) - 0.33 * (log(EXP_des[co,h]{-1}) - log(EXP_n[co,h]{-1})) if EXP[co,h] <> 0
@over log(EXP[co,h]) = log(EXP_n[co,h])*(@year<=2019) +   (log(EXP[co,h]{-1}) + d(log(EXP_des[co,h])))*(@year>2019)    if EXP[co, h] <> 0


#### INTRODUCTION DYNAMIQUE SUR LES EXPORTATIONS ####

d(log(X_n_des[c])) = d(log(WD[c])) + d(SUBST_X[c]) if X[c] <> 0

d(log(X_des[cdai])) = 0.91*d(log(WD[cdai])) - 0.33*d(log(PX[cdai]/(TC*PWD[cdai]))) - 0.27*(log(X_des[cdai]{-1})-log(X_n_des[cdai]{-1})) if X[cdai] <> 0
@over d(log(X[cdai])) = (@year<=2019)*(d(log(Xexo[cdai]))) + (@year>2019)*(d(log(X_des[cdai]))) if X[cdai] <> 0

d(log(X_des[cservex])) = 0.49*d(log(WD[cservex])) - 0.35*d(log(PX[cservex]/(TC*PWD[cservex]))) - 0.24*(log(X_des[cservex]{-1})-log(X_n_des[cservex]{-1})) if X[cservex] <> 0
@over d(log(X[cservex])) = (@year<=2019)*(d(log(Xexo[cservex]))) + (@year>2019)*(d(log(X_des[cservex]))) if X[cservex] <> 0

#### MODIFICATION DES FACTEURS D AJUSTEMENT #####
 
@over d(log(Y_e[s])) = 0.3 * d(log(Y_e[s]{-1})) + (1 - 0.3) * d(log(Y[s])) + 0.3 * (log(Y[s]{-1}) - log(Y_e[s]{-1}))

@over d(log(PY_e[s]))  = 0.05  * d(log(PY_e[s]{-1}))  + 0.65  * d(log(PY[s]{-1}))  + 0.3  * d(log(PY_n[s]))

# PY_n en ligne avec la v3
@over PY_n[sne] = NCU_n[sne] * (1 + TMD_n[sne]) if Y[sne] > 0

#P_e en ligne avec la v3
@over d(log(P_e)) = (@year<=2019) * (ADJUST(68,2)*d(log(P_e{-1})) + (1-ADJUST(68,2))*d(log(P{-1})) - ADJUST(68,6)*log(P_e{-1}/P{-1})) + (@year>2019)* ( 0.3*d(log(P_e{-1})) + (1-0.3)*d(log(P{-1})) - 0.3*log(P_e{-1}/P{-2}))

@over d(log(PARTR_e[sex, age])) = 0.05 * d(log(PARTR_e[sex, age]{-1})) + 0.65 * d(log(PARTR[sex, age]{-1})) + 0.3 * d(log(PARTR_n[sex, age])) if PARTR[sex, age] <> 0

@over d(log(|V|_e[s])) = 0.05 * d(log(|V|_e[s]{-1})) + 0.65 * d(log(|V|[s]{-1})) + 0.3 * d(log(|V|_n[s])) if |V|[s] <> 0 where V in L E MAT

@over log(|V|[c]) = (@year <= 2019) * ( ADJUST(14 + $V, 1) * log(|V|_n[c]) + (1 - ADJUST(14 + $V, 1)) * (log(|V|[c]{-1}) + d(log(|V|_e[c])))) + (@year > 2019) * (0.5 * log(|V|_n[c]) + (1 - 0.5) * (log(|V|[c]{-1}) + d(log(|V|_e[c])))) if |V|[c] <> 0 where V in SD SM

@over d(log(|V|_e[c])) = 0.05 * d(log(|V|_e[c]{-1})) + 0.65 *d(log(|V|[c]{-1})) + 0.3 * d(log(|V|_n[c])) if |V|[c] <> 0 where V in SD SM

#�quilibre comptable OK 
# coefficients d'ajustements: 0.8 partout
@over SUBST_K_NE[s]  = 0.8  * SUBST_K_NE_n[s]  + ( 1  - 0.8 )  * SUBST_K_NE[s]{-1}
@over SUBST_K_E[s]  = 0.8  * SUBST_K_E_n[s]  + ( 1  - 0.8 )  * SUBST_K_E[s]{-1}
@over SUBST_|V|[s] = 0.8 * SUBST_|V|_n[s] + (1 - 0.8) * SUBST_|V|[s]{-1} if |V|[s] <> 0 where V in K L E MAT

@over SUBST_CHD[c]  = 0.8 * SUBST_CHD_n[c]  + ( 1  - 0.8 )  * (SUBST_CHD[c]{-1}) if CHD[c] <> 0
@over SUBST_CHM[c] = 0.8 * SUBST_CHM_n[c]  + ( 1  - 0.8)  * (SUBST_CHM[c]{-1}) if CHM[c] <> 0
@over SUBST_GD[c]  = 0.8  * SUBST_GD_n[c]  + ( 1  - 0.8 )  * (SUBST_GD[c]{-1}) if GD[c] <> 0 
@over SUBST_GM[c]  = 0.8  * SUBST_GM_n[c]  + ( 1  - 0.8 )  * (SUBST_GM[c]{-1}) if GM[c] <> 0
@over SUBST_X[c] = 0.8 * SUBST_X_n[c] + (1- 0.8) * (SUBST_X[c]{-1}) if X[c] <> 0
@over SUBST_XD[c] = 0.8  * SUBST_XD_n[c] + (1- 0.8 ) * (SUBST_XD[c]{-1}) if XD[c] <> 0
@over SUBST_XM[c] = 0.8 * SUBST_GM_n[c] + (1- 0.8 ) * (SUBST_XM[c]{-1}) if XM[c] <> 0

# retrait anticipation dividendes et alignement sur autres coef d'ajustement
@over DIV_HH_VAL  = 0.8  * DIV_HH_VAL_n  + ( 1  - 0.8 )  *  DIV_HH_VAL{-1}  + 0* d(DIV_HH_VAL_e) 
@over DIV_GOV_VAL  = 0.8 * DIV_GOV_VAL_n  + ( 1  - 0.8 )  *  DIV_GOV_VAL{-1}  + 0*d(DIV_GOV_VAL_e) 
# ne change rien
@over d(log(DIV_|V|_VAL_e)) = 0.05 * d(log(DIV_|V|_VAL_e{-1})) + 0.65 * d(log(DIV_|V|_VAL{-1})) + 0.3 * d(log(DIV_|V|_VAL_n)) where V in HH GOV

# effet comp�titivit� prix des exportations en ligne avec M�sange (vs ES_ext_choc = 0.4 avant)
@over d(SUBST_X_n[c]) = (@year<=2022)*(-ES_X($c, 1) * d(log(PX[c]) - log(TC*PWD[c]))) _ 
                        +(@year>2022)*(-ES_X($c, 1)* d(log(PX[c]) - log(TC*PWD[c]))) if X[c] <> 0  #  where c in 05 06 12 13

### distinction prix courants vs prix constants de prix des �nergies fossiles ####

# deflateur au lieu de 2% par an (proxy utilis� par l'ademe pour eviter un plantage
@over PWD[ce2] = PWD_constant[ce2]*PGDP + choc_fossile[ce2]
# change pas mal les resultats dans choc d'investissement

#### CORRECTION DESEQ #####
@over K_NE_des_n_19  = ( @year <= 2019 )  * ( K_n_19 > 0 )  * K_NE_n_19{-1}  * ( K_n_19/K_n_19{-1} )  + _
                 ( @year > 2019 )  * (AME_renov_19 *( K_NE_des_n_19{-1} * ( 1 + d(Y_19)/Y_19{-1} - d(PROG_K_19)/prog_K_19{-1} + IMP_BUD_19 * @elem(GDP , %baseyear)/@elem(K_n_19 , %baseyear)  + _
                  Choc_CSC_19  + d(Inv_IRVE)  / K_n_19{-1} + sobre_19 ) + K_n_19{-1}  * d(SUBST_K_NE_19) ) + _ 
                       (1- AME_renov_19)*(K_NE_des_n_19{-1}*(1 - tdec_19) + I_NE_19))

@over K_NE_des_n_20  = AME_renov_20 *(K_NE_des_n_20{-1} * ( 1 + d(Y_20)/Y_20{-1} - d(PROG_K_20)/prog_K_20{-1} + d(INV_road)/K_n_20{-1} + _
                  IMP_BUD_20 * @elem(GDP , %baseyear)/@elem(K_n_20 , %baseyear) + Choc_DACCS) + K_n_20{-1} * d(SUBST_K_NE_20)) + _
                (1- AME_renov_20)*(K_NE_des_n_20{-1}*(1 - tdec_20) + I_NE_20)


#### MODIFICATIONS RELATIVES A LA SIMULATION DE MA PRIME RENOV' ####


#correction double compte de MPR dans le revenu des menages
# prise en compte des d�penses de r�novation pay�es comptant dans les depenses de logement : on remplace les depenses de renovation en valeur apres deduction de la subvention par les depenses de renovation avant subvention
@over EXP_HOUSING_Val[h,ecl] = ( @year > %baseyear ) * ( DEBT_REHAB_Val[h,ecl]{-1} * (R_I_REHAB[h,ecl]{-1} + R_RMBS_REHAB[h,ecl]{-1} ) + R_CASH_REHAB[h,ecl] * RENOV_VAL[ecl]  + DEBT_NewB_Val[h,ecl]{-1} * ( R_I_NewBUIL[h,ecl]{-1} + R_RMBS_NewBUIL[h,ecl]{-1} )  + R_CASH_NewBUIL[h,ecl] * PNewBUIL[h,ecl] * NewBUIL[h,ecl] + PENER_BUIL[h,ecl] * ENER_BUIL[h,ecl] + choc_PAC_VAL[ecl])   + ( @year =< %baseyear ) * EXP_HOUSING_Val[h,ecl]{-1} * ( 1 + STEADYSTATE(1,1) )
   
 # dette des menages pour la r�novation : les m�nages s'endettent sur une part du montant total des depenses avant subvention et non pas apres subvention  
@over DEBT_REHAB_Val[h,ecl] = (@year > %baseyear) * ( ( 1 - R_RMBS_REHAB[h,ecl] ) * DEBT_REHAB_Val[h,ecl]{-1}  + R_LOAN_REHAB[h,ecl] * RENOV_VAL[ecl] ) + (@year =< %baseyear) * DEBT_REHAB_Val[h,ecl]{-1} * ( 1 + STEADYSTATE(1,1) )

# subventions CEE et MPR ajoutees au RDB
@over DISPINC_VAL[h] = DISPINC_AI_VAL[h] - IR_VAL[h] - AIC_VAL[h] + REDIS_VAL_H + SUB_AUTO_VAL + SUB_REHAB_VAL   

# prix moyen pond�r� au m2 des depenses de renovation (pond�r� par les types de renov) avant subvention
PREHAB_H01_HS= RENOV_VAL/REHAB_H01
PREHAB_H01_HS[ecl]= RENOV_VAL[ecl]/REHAB_H01[ecl] if REHAB_H01[ecl] <> 0

# EXP_13 repr�sente les d�penses en logement a prix constants 2006. Elle evolue en ligne avec les volumes de construction neuve, de renov et autres depenses de logement. 
# EXP_13 sert a calculer EXP_h01 qui ensuite sert a deduire l'epargne du menage (S_H01  = DISPINC_VAL_H01  - PEXP_H01  * EXP_H) avec PEXP_13_H01 qui capture a la fois les dynamiques de prix et de taux de subvention (variable PREHAB_H01[ecl], prix apr�s subvention).
# on veut donc EXP_13 en volume  (prix constants 2006 et hors subvention)pour ne pas capturer les dynamiques de prix et de taux de subvention (deja capture dans PEXP)

# 1. on remplace PREHAB_H01 (prix de r�nov apr�s subvention) par PREHAB_H01_HS au cas o� une subvention existe avant 2006. Actuellement, il n'y a pas de subvention en 2006 donc PREHAB_H01_HS(2006) = PREHAB_H01(2006). 
# 2. avant 2019 On avait CHD_13  - SUB_REHAB_VAL. pas de sens de soustraire une subvention en valeur. Par cons�quent avant 2019 on n'avait pas EXP_13 = CHD_13. De plus la subvention est ensuite deja capturee dans PEXP. Elle �tait captur�e deux fois (dans EXP et dans PEXP) pour deduire l'epargne. 

# consommation de construction a prix constants 2006. 
EXP_13_des =  @elem(PNewBUIL_H01  , 2006)  * NewBUIL_H01  + @elem(PREHAB_H01_HS, 2006)  * REHAB_H01  + (EXP_13_OTH_Val_H01 )/ PCH_13 + choc_PAC

@over EXP_13_H01  = (EXPexo[13])*(@year<=2019)+(EXP_13_H01{-1} * (1 + d(EXP_13_des)/EXP_13_des{-1}))*(@year>2019) 

# CHD_13 repr�sente la consommation de production domestique de construction avant subvention (MPR et CEE) � prix constants 2006. Variable de comptabilit� nationale utilis�e pour calculer le PIB. 
# On veut pas inclure de dynamique de subvention en valeur qui capturerait les dynamiques de prix de renovation dans cette equation a prix constants. on supprime SUB_REHAB_VAL
@over CHD[13] = ((EXPexo[13]-CHM[13] > 0) * (EXPexo[13] - CHM[13]) + (EXPexo[13] - CHM[13] =< 0) * (0.00001))*(@year<=2019) +(EXP_13-CHM_13)*(@year>2019)     if CHD[13] <> 0


#### CORRECTION DU CALCUL DES COUTS UNITAIRES DE PRODUCTION NOTIONNELS ####

PE_CEE[se] = CEE[se]/(Ener[se] + 0.0001)
PE_CEE_n[se] = CEE[se]/(E_n[se] + 0.0001)

CU_n_des[s] * Y[s] = CK[s] * K_n[s] + CL[s] * L_n[s] * PROG_L[s] + (PE[s] + PE_CEE_n[s] + PE_signal_bis[s]) * E_n[s] + PMAT[s] * MAT_n[s] if Y[s] > 0
  
CU_des[s]*Y[s] = CK[s]*K[s] + CL[s]*L[s]*PROG_L[s] + (PEner[s] + PE_CEE[s] + PE_signal_bis[s])*Ener[s] + PMAT[s]*MAT[s] if Y[s] > 0

d(log(CU_n_bis[s])) = phi_n_k[s]{-1} * d(log(CK[s]/PROG_K[s])) + phi_n_l[s]{-1} * d(log(CL[s])) + phi_n_e[s]{-1} * d(log((PE[s] + PE_CEE_n[s] + PE_signal_bis[s])/PROG_E[s])) + phi_n_mat[s]{-1} * d(log(PMAT[s])) if Y[s] > 0

@over d(log(CU_n[s])) = (@year<=2019) * d(log(CU_n_des[s])) + (@year>2019) * d(log(CU_n_bis[s])) if Y[s] >0

#### INTEGRATION DU PROGRES TECHNIQUES DANS LES TERMES DE SUBSTITUTION ####

phi_K_bis[s] = K[s] * CK[s] / (K[s] * CK[s] + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s])
phi_L_bis[s] = L[s] * PROG_L[s] * CL[s] / (K[s] * CK[s] + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s])
phi_E_bis[s] = (E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s])) / (K[s] * CK[s] + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s])
phi_MAT_bis[s] = MAT[s] * PMAT[s] / (K[s] * CK[s] + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s])
 

    @over d(SUBST_K_n[s]) = _
     -ES_KLEM($s, 1) * d(log(CK[s]/PROG_K[s]) - log(CL[s]))                    * phi_l_bis[s]{-1} _
     -eta_K_E[s]     * d(log(CK[s]/PROG_K[s]) - log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s] + PE_signal_E[s])/PROG_E[s]))   * phi_e_bis[s]{-1} _
     -ES_KLEM($s, 3) * d(log(CK[s]/PROG_K[s]) - log(PMAT[s]))                  * phi_mat_bis[s]{-1} _
   if K_n[s] <> 0
   
    @over d(SUBST_E_n[s]) = _
     -eta_K_E[s]     * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s] + PE_signal_E[s])/PROG_E[s]) - log(CK[s]/PROG_K[s]))   * phi_k_bis[s]{-1} _
     -eta_L_E[s]     * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s]) - log(CL[s]))   * phi_l_bis[s]{-1} _
     -ES_KLEM($s, 6) * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s]) - log(PMAT[s])) * phi_mat_bis[s]{-1} _
   if E_n[s] <> 0
   
    @over d(SUBST_L_n[s]) = _
     -ES_KLEM($s, 1) * d(log(CL[s]) - log(CK[s]/PROG_K[s]))                  * phi_k_bis[s]{-1} _
     -eta_L_E[s]     * d(log(CL[s]) - log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s])) * phi_e_bis[s]{-1} _
     -ES_KLEM($s, 5) * d(log(CL[s]) - log(PMAT[s]))                * phi_mat_bis[s]{-1} _
   if L_n[s] <> 0
   
    @over d(SUBST_MAT_n[s]) = _
     -ES_KLEM($s, 3) * d(log(PMAT[s]) - log(CK[s]/PROG_K[s]))                * phi_k_bis[s]{-1} _
     -ES_KLEM($s, 5) * d(log(PMAT[s]) - log(CL[s]))                * phi_l_bis[s]{-1} _
     -ES_KLEM($s, 6) * d(log(PMAT[s]) - log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s])) * phi_e_bis[s]{-1} _
   if MAT_n[s] <> 0
   
    @over d(SUBST_K_n[s]) = _
     -ES_KLEM($s, 1) * d(log(CK[s]/PROG_K[s]) - log(CL[s]))                    * phi_l_bis[s]{-1} _
     -eta_K_E[s]     * d(log(CK[s]/PROG_K[s]) - log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s]))   * phi_e_bis[s]{-1} _
     -ES_KLEM($s, 3) * d(log(CK[s]/PROG_K[s]) - log(PMAT[s]))                  * phi_mat_bis[s]{-1} _
   if K_n[s] <> 0
   
 @over d(SUBST_K_NE_n[s]) = _
     -ES_KLEM($s, 1) * d(log(CK[s]/PROG_K[s]) - log(CL[s]))                    * phi_l_bis[s]{-1} _
     -0     * d(log(CK[s]/PROG_K[s]) - log((PE[s] + PE_signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s]))   * phi_e_bis[s]{-1} _
     -ES_KLEM($s, 3) * d(log(CK[s]/PROG_K[s]) - log(PMAT[s]))                  * phi_mat_bis[s]{-1} _
   if K_n[s] <> 0

 @over d(SUBST_K_E_n[s]) = _
     -0 * d(log(CK[s]/PROG_K[s]) - log(CL[s]))                    * phi_l_bis[s]{-1} _
     -eta_K_E[s]      * d(log(CK[s]/PROG_K[s]) - log((PE[s] + PE_signal[s] + PE_CEE[s] + PE_signal_bis[s] + PE_signal_E[s])/PROG_E[s]))   * phi_e_bis[s]{-1} _
     -0 * d(log(CK[s]/PROG_K[s]) - log(PMAT[s]))                  * phi_mat_bis[s]{-1} _
   if K_n[s] <> 0
   
#### MODIFICATION DEMANDE ENERGETIQUE DANS LES SERVICES ####

@over d(log(E_oth_n[ster])) = AME_renov[ster] * (d(log(Y[ster])) + d(SUBST_E[ster]) - d(log(PROG_E[ster])) + d(E_shock_exo[ster])) + (1 - AME_renov[ster]) * (d(log(E_oth_exo[ster])))

#### CROISSANCE DE L'EFFICACITE ENERGETIQUE ####
#@over GR_PROG_E[sne]  = alpha_PROG_E[sne]  + ((d(log(PE[sne] + PE_Signal[sne] + PE_CEE[sne] + PE_signal_bis[sne])))>0) *( alpha_PROG_E_PE[sne]  * ( d(log(PE[sne] + PE_Signal[sne] + PE_CEE[sne] + PE_signal_bis[sne])) )) + ((d(log(PE[sne] + PE_Signal[sne] + PE_CEE[sne] + PE_signal_bis[sne])))<=0) * (0)


#### MISE EN COHERENCE DES FACTEURS DE PONDERATION DANS LES EQUATIONS DE SUBSTITUTION AVEC LE RESTE DU MODELE ET LA V3 ####

kappa_mat_dgt[trsp, s] = (PMAT[trsp, s] * MAT[trsp, s] / (PMAT[s] * MAT[s])) if MAT[trsp, s] <> 0 where (trsp) in (%list_trsp)

 @over d(SUBST_MAT_n[trsp, s]) = sum( -ES_TRANSP_CI($s, cols_mat(trsp, trsp_oth)) * d(log(PMAT[trsp, s]) - log(PMAT[trsp_oth, s])) * _
                                 @elem((MAT[trsp_oth, s] / (MAT[s]) ),2019) if (trsp_oth <> trsp) * (trsp*trsp_oth <> 240) on trsp_oth in %list_trsp) _
                                 if MAT[trsp_cond, s] <> 0 where (trsp, trsp_cond) in (%list_trsp, %list_trsp)

 @over d(SUBST_MAT_n[trsp, s]) = sum( -ES_TRANSP_CI($s, cols_mat(trsp, trsp_oth)) * d(log(PMAT[trsp, s]) - log(PMAT[trsp_oth, s])) * _
                                 kappa_mat_dgt[trsp_oth, s]{-1} if (trsp_oth <> trsp) * (trsp*trsp_oth <> 240) on trsp_oth in %list_trsp) _
                                 if MAT[trsp_cond, s] <> 0 where (trsp, trsp_cond) in (%list_trsp, %list_trsp)

 kappa_X|O1|_dgt[c] = (PX|O1|[c] * X|O1|[c] / (PX[c] * X[c])) if X|O1|[c] <> 0 where O1 in (D M)
 
 @over d(SUBST_X|O1|_n[c]) = -ES_X($c, 2) * d(log(PX|O1|[c]) - log(PX|O2|[c])) * @elem((PX|O2|[c] * X|O2|[c] / (PX[c] * X[c])),2019) if X|O1|[c] <> 0 where (O1, O2) in (D M, M D)

 @over d(SUBST_X|O1|_n[c]) = -ES_X($c, 2) * d(log(PX|O1|[c]) - log(PX|O2|[c])) * kappa_X|O2|_dgt[c]{-1} if X|O1|[c] <> 0 where (O1, O2) in (D M, M D)


@over d(SUBST_E[ce, s]) = 0.8 *  d(SUBST_E_n[ce, s]) + (1 - 0.8) *  d(SUBST_E[ce, s]{-1}) if E[ce, s] <> 0

kappa_e_dgt[ce, s] = (PE[ce, s] * E[ce, s]/ (PEner[s] * Ener[s])) if E[ce, s] <> 0

@over d(SUBST_E_n[ce, s]) = sum( -ES_NRJ($s, cols_ce(ce, ce_oth)) * d(log(PE[ce, s] + PE_Signal[ce, s] + PE_Signal_bis[ce, s]) - log(PE[ce_oth, s] + PE_Signal[ce_oth, s] + PE_Signal_bis[ce_oth, s])) * _
                               kappa_e_dgt[ce_oth, s]{-1} if ce_oth <> ce on ce_oth in %list_com_E) _
                               if E[ce, s] <> 0

@over d(log(E_oth_des[ce, s])) = d(log(E_oth[s])) + d(SUBST_E[ce, s]) if E_oth_des[ce, s] <> 0

@over dlog(E_oth_des[ce, se]) = dlog(E_oth[se]) + d(SUBST_E[ce, se]) + (@year>2006)*d(Q_Mtep_in[ce, se])/E[ce, se]{-1}    if E_oth_des[ce, se] <> 0
   

@over E_oth_des[ce,road] = E_oth_n[ce,road] where ce  in %list_com_E \ 21
@over E_oth[ce,road] = E_oth_n[ce,road] where ce  in %list_com_E \ 21

@over E_oth_n[road] = sum(E_oth_n[ce,road] on ce)  

#### MODIFICATION DYNAMIQUE DES PRESTATIONS ####

L_SM = L - L_20
W_SM * L_SM = sum(W_S[s] * L_S[s] + W_SE[s] * L_SE[s] on s in %list_sec_Market)

d(log(PRESOC_DOM_U_TETE_DES)) = d(PRESOC_DOM_U_TETE_shock) + 0.47*log(@elem(PRESOC_DOM_U_TETE_DES,2019)/@elem(W_SM,2019)) + 0 - 0.47 * (log(PRESOC_DOM_U_TETE_DES{-1}) - PRESOC_DOM_U_TETE_shock{-1} - log(W_SM{-1}))
PRESOC_DOM_U_VAL_DES = PRESOC_DOM_U_TETE_DES * Un_TOT
@over PRESOC_DOM_U_VAL = (@year<=2019)*(STEADYSTATE(54, 1) * W_S * Un_Tot) + (@year>2019)*(PRESOC_DOM_U_VAL_DES)

d(log(PRESOC_DOM_Oth_VAL_DES)) = d(PRESOC_DOM_Oth_shock) + 0.64*log(@elem(PRESOC_DOM_Oth_VAL_DES,2019)/(@elem(P,2019)*@elem(PROG_L,2019)*@elem(POP_tot,2019))) + 0.64*d(log(P)) - 0.64*(log(PRESOC_DOM_Oth_VAL_DES{-1}) - PRESOC_DOM_Oth_shock{-1} - log(P{-1}) - log(PROG_L{-1}) - log(POP_tot))
@over d(log(PRESOC_DOM_Oth_VAL)) = (@year<=2019)*(STEADYSTATE(53, 1) * d(log(PROG_L)) + d(log(P)) + d(log(POP_tot))) + (@year>2019)*(d(log(PRESOC_DOM_Oth_VAL_DES)))

#corr    #### MODIFICATIONS RELATIVES A LA SIMULATION DE LA DECARBONATION DU MIX ENERGETIQUE ####
 
 #corr    ## Investissements (et stock de capital) des secteurs �nerg�tiques hors �lectricit�
 #corr    # investissement notionnel sans choc 
 #corr    d(log(IA_notionnel_noshock[se_noelec])) = dlog(Y[se_noelec]) + d(SUBST_K[se_noelec]) - dlog(PROG_K[se_noelec])  if IA_n[se_noelec] <> 0 
 #corr    # Investissement observ�
 #corr    d(log(IA_n_des[se_noelec]))  = d(IMP_BUD_niv_bis[se_noelec]) + ( ADJUST(1  , 1)  * dlog(IA_n_des[se_noelec]{-1})  + 1.8  * dlog(Y[se_noelec]) + 0.28  * ( log(IA_notionnel[se_noelec]{-1}) + IMP_BUD_niv_bis[se_noelec]{-1} - log(IA_n_des[se_noelec]{-1}) )  + ADJUST(1, 4) * 0 * d(SUBST_K[se_noelec]) ) if IA_n[se_noelec] <> 0 
 #corr    @over d(log(IA_n[se_noelec])) = ( @year <= 2019 )  * ( ( IAexo[se_noelec] > 0 )  * ( dlog(IAexo[se_noelec]) ) )  + ( @year > 2019 )  * (d(log(IA_n_des[se_noelec]))) if IA_n[se_noelec] <> 0 
 #corr    #R��criture du choc CSC en niveau
 #corr    Choc_CSC_niv[se_noelec] = CSC_cost * EMS_CSC[se_noelec] #attention dans l'utilisation de ce type de choc : l'unit� n'est pas la m�me que celle de la variable dans laquelle il intervient ensuite (ici CO2 contre euros pour l'investissement) 
 #corr    # Investissement notionnel avec le choc en niveau
 #corr    IA_notionnel[se_noelec] = IA_notionnel_noshock[se_noelec] + (@year > 2019) * (Choc_CSC_niv[se_noelec]) if IA_n[se_noelec] <> 0 
 #corr    # stock de capital notionnel
 #corr    @over K_n[se_noelec] = (1 - Tdec[se_noelec]) * K_n[se_noelec]{-1} + IA_notionnel[se_noelec] + IMP_BUD_niv[se_noelec] if K[se_noelec] <> 0 
 
 #corr    # les investissements des secteurs de l'�lectricit� sont laiss�s exog�nes.
 
 #corr    # Stock de capital observ�: mod�lisation du stock de K observ� des secteurs du gaz en ligne avec les autres secteurs
 #corr    @over K[se24] = (1 - Tdec[se24])  * K[se24]{-1}  + IA[se24]

## modification du taux de marge (alignement sur les s) pour ne pas avoir des reactions abruptes face aux chocs de mix energetique   

# part des facteurs de production dans la production en valeur
phi_n_K[se] = K_n[se] * CK[se] / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * (PE[se] + PE_CEE_n[se] + PE_signal_bis[se]) + MAT_n[se] * PMAT[se])
phi_n_L[se] = L_n[se] * PROG_L[se] * CL[se] / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * (PE[se] + PE_CEE_n[se] + PE_signal_bis[se]) + MAT_n[se] * PMAT[se])
phi_n_E[se] = (E_n[se] * (PE[se] + PE_CEE_n[se] + PE_signal_bis[se])) / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * (PE[se] + PE_CEE_n[se] + PE_signal_bis[s]) + MAT_n[se] * PMAT[se])
phi_n_MAT[se] = MAT_n[se] * PMAT[se] / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * (PE[se] + PE_CEE_n[se] + PE_signal_bis[se]) + MAT_n[se] * PMAT[se])
# reflechir plus tard sur PE_CEE et sa presence dans ces parts.

# Capacit� de production (fonction de production �valu�e aux quantit�s effectives de facteurs, comme dans la V3)
# charbon 
d(log(YCAP_21)) = phi_n_L_21{-1} * d(log(L_21 * PROG_L_21) ) + phi_n_K_21{-1} * d(log(K_21 * PROG_K_21) ) + phi_n_E_21{-1} * d(log(E_21 * PROG_E_21) ) + phi_n_MAT_21{-1} * d(log(MAT_21) ) if YCAP_21 <> 0
# p�trole
d(log(YCAP_2201)) = phi_n_L_2201{-1} * d(log(L_2201 * PROG_L_2201) ) + phi_n_K_2201{-1} * d(log(K_2201 * PROG_K_2201) ) + phi_n_E_2201{-1} * d(log(E_2201 * PROG_E_2201) ) + phi_n_MAT_2201{-1} * d(log(MAT_2201) ) if YCAP_2201 <> 0
d(log(YCAP_2202)) = phi_n_L_2202{-1} * d(log(L_2202 * PROG_L_2202) ) + phi_n_K_2202{-1} * d(log(K_2202 * PROG_K_2202) ) + phi_n_MAT_2202{-1} * d(log(MAT_2202) ) if YCAP_2202 <> 0
#�lec
d(log(YCAP[se23])) = phi_n_L[se23]{-1} * d(log(L[se23] * PROG_L[se23]) ) + phi_n_K[se23]{-1} * d(log(K[se23] * PROG_K[se23]) ) + phi_n_E[se23]{-1} * d(log(E[se23] * PROG_E[se23]) ) + phi_n_MAT[se23]{-1} * d(log(MAT[se23]) ) if YCAP[se23] <> 0
# gaz
d(log(YCAP_2401)) = phi_n_L_2401{-1} * d(log(L_2401 * PROG_L_2401) ) + phi_n_K_2401{-1} * d(log(K_2401 * PROG_K_2401) ) + phi_n_E_2401{-1} * d(log(E_2401 * PROG_E_2401) ) + phi_n_MAT_2401{-1} * d(log(MAT_2401) ) if YCAP_2401 <> 0
d(log(YCAP[se24])) = phi_n_L[se24]{-1} * d(log(L[se24] * PROG_L[se24]) ) + phi_n_K[se24]{-1} * d(log(K[se24] * PROG_K[se24]) ) + phi_n_MAT[se24]{-1} * d(log(MAT[se24]) ) if YCAP[se24] <> 0 where se24 in %list_sec_24\ 2401  

# taux d'utilisation des capacit�s
CUR_bis[se] = Y[se]/YCAP[se]
# taux d'utilisation des capacit�s corrig� (ECM)
@over d(log(CUR_test[se])) = 0.6 * d(log(CUR_bis[se])) + 0.4 * d(log(CUR_cible[se])) - 0.6 * (log(CUR_test[se]{-1}) - log(CUR_cible[se]{-1}))
#taux de marge
@over dlog(1+TMD_n[se]) = (0.4 * ( dlog(Y[se])-dlog(Y_e[se]{-1})))*(@year<=2019) + ((TMD_n[se]{-1}>0.01)*(0.4 * d(log(CUR_test[se]))) + (TMD_n[se]{-1}<=0.01)*(0.000001)) * (@year > 2019) if Y[se] > 0

#### MODIFICATIONS RELATIVES A LA SIMULATION DES CERTIFICATS D'ECONOMIE D'ENERGIE ####

# MPR vs CEE : deux modes de versement diff�rents
# MPR = les m�nages s'acquittent du devis de r�novation avant subvention MPR (avancement des frais). Puis font la demande de subvention MPR et la re�oivent qq semaines plus tard
# CEE = les m�nages s'acquittent du devis de r�novation apr�s subvention CEE. Pas d'avancement des frais
# Les deux subventions sont cumulables

# D�penses de r�novation en valeur apr�s subvention CEE (avant sbvention MPR)
RENOV_VAL_apCEE[ecl] = sum(PREHAB_h01[ecl,ecl2]*(1 - R_SUB_CEE[h,ecl,ecl2])*REHAB_h01[ecl,ecl2] if REHAB_h01[ecl,ecl2] <> 0 on ecl2)

RENOV_VAL_apCEE = (sum( sum(PREHAB_h01[ecl,ecl2]* (1 - R_SUB_CEE[h,ecl,ecl2])* REHAB_h01[ecl,ecl2] if REHAB_h01[ecl,ecl2] <> 0 on ecl2) on ecl))  

# Dette des menages pour la r�novation : les m�nages s'endettent sur une part du montant total des depenses apres subvention pour les CEE et avant subvention pour MPR
@over DEBT_REHAB_Val[h,ecl] = (@year > %baseyear) * ( ( 1 - R_RMBS_REHAB[h,ecl] ) * DEBT_REHAB_Val[h,ecl]{-1}  + R_LOAN_REHAB[h,ecl] * RENOV_VAL_apCEE[ecl] ) + (@year =< %baseyear) * DEBT_REHAB_Val[h,ecl]{-1} * ( 1 + STEADYSTATE(1,1) )

# D�penses des m�nages en logement : paiement comptant des d�penses de r�novation apr�s CEE mais avant MPR
@over EXP_HOUSING_Val[h,ecl] = ( @year > %baseyear ) * ( DEBT_REHAB_Val[h,ecl]{-1} * (R_I_REHAB[h,ecl]{-1} + R_RMBS_REHAB[h,ecl]{-1} ) + R_CASH_REHAB[h,ecl] * RENOV_VAL_apCEE[ecl]  + DEBT_NewB_Val[h,ecl]{-1} * ( R_I_NewBUIL[h,ecl]{-1} + R_RMBS_NewBUIL[h,ecl]{-1} )  + R_CASH_NewBUIL[h,ecl] * PNewBUIL[h,ecl] * NewBUIL[h,ecl] + PENER_BUIL[h,ecl] * ENER_BUIL[h,ecl] + choc_PAC_VAL[ecl])   + ( @year =< %baseyear ) * EXP_HOUSING_Val[h,ecl]{-1} * ( 1 + STEADYSTATE(1,1) )   

# Revenu disponible des m�nages: seule la subvention MPR est re�ue (subvention CEE deja d�duite des d�penses de logements).
@over DISPINC_VAL[h] = DISPINC_AI_VAL[h] - IR_VAL[h] - AIC_VAL[h] + REDIS_VAL_TCO_H + REDIS_VAL_ETS2_H + SUB_AUTO_VAL  + SUB_RENOV_VAL


# A FAIRE run3: modeliser les CEE comme une taxe plutot que dans co�t unitaire et exclure industrie de la taxe.

#### CORRECTION BLOC LOGEMENT ####
# taux de renovation par classe energetique.  #initialis� � taux_rehab
@over d(tau_REHAB_2[h,ecl]) = 0.5*d(tau_REHAB_N[h,ecl]) + (1-0.5)*d(tau_REHAB[h,ecl]{-1}) + 0.05 * (tau_REHAB_N[h,ecl]{-1}-tau_REHAB[h,ecl]{-1})  if tau_REHAB[h,ecl] <> 0  
# modifie les niveaux de REHAB AME. 


#### FINANCEMENT DES MESURES PAR PO ####

### COTISATIONS SOCIALES ###

# hausse de taux de cotsoc salari�s
choc_tcss = - choc_css /(L_S * W_S)
# hausse de taux de cotsoc ind�pendants
choc_tcss_se = - choc_css_se /(L_SE * W_SE)
# hausse de taux de cotsoc employeurs
choc_tcse[s] = - choc_cse /(L_S * W_S)
choc_tcse = choc_tcse[s]
@over TCSE[s] = @elem(TCSE[s], %baseyear) + choc_tcse[s]

# revenu disponible avant impot : on exclut les revenus de l'�tranger du choc sur le taux de cotsoc
@over DISPINC_AI_VAL = (W_S * L_S) * (1- (TCSS + choc_tcss) ) + SB_ROW * (1- TCSS)+ (W_SE * L_SE) * (1-(TCSS_SE + choc_tcss_se)) + PRESOC_DOM_VAL + FW_VAL + TR_ROW_VAL
@over DISPINC_AI_VAL[h] = (W_S[h] * L_S[h]) * (1-(TCSS[h]+ choc_tcss))  + SB_ROW[h] * (1- TCSS) + (W_SE[h] * L_SE[h]) * (1-(TCSS_SE[h] + choc_tcss_se)) + PRESOC_DOM_VAL[h] + FW_VAL[h] + TR_ROW_VAL[h]

# cotsoc
@over CSS[s] * PCSS[s] = (TCSS + choc_tcss)  * L_S[s] * W_S[s]
@over CSS_SE[s] * PCSS_SE[s] = (TCSS_SE + choc_tcss_se)  * L_SE[s] * W_SE[s]

### IS ###

# choc d'IS ventil�s par secteur uniquement sur les secteurs payant l'IS
@over TIS[s] = TIS_exo[s] - (choc_IS[s]+ TAX_CR_VAL[s])/(PRF[s]{-1} * RF[s]{-1} +0.0000001) 

# � faire pour run3: CI �lectrification des PL a ajouter � l'IS si c'est bien un CI. 

### IR ###
@over d(TIR[h]) = -d((choc_IR)/ DISPINC_AI_VAL[h]) + d(TIR_TREND)


#### MODIFICATIONS FISCALITE CARBONE POUR ISOLER COMPOSANTE CARBONE, ACCISES, ETS1 ET ETS2 #### 
 
dlog(defl_Ttco[ce2]) = dlog(PCH)
@over TCO_VAL[ce2, s] = Ttco[ce2] * EMS_SEC[ce2, s] * (1 - EXO[ce2, s]) + PE_signal_ETS * PCH * EMS_SEC[ce2, s] * EXO[ce2, s]
@over TCO_VAL[ce2, s] = (Ttco[ce2] + PCH * ETS2[s])  * EMS_SEC[ce2, s] * (1 - EXO[ce2, s]) + PE_signal_ETS * PCH * EMS_SEC[ce2, s] * EXO[ce2, s]  where s in 14 15 16 17 19 20 #13 
@over Ttco_vol[ce2] = Ttco[ce2] 
 
@over tco_val_hh[ce2, h] = (ttco[ce2] + ETS2_hh[ce2]) * pch * ems_hh[ce2, h] ### ajout de l'ets2 qui touchera egalement directement les menages apres discussion avec la DGEC



#@over REDIS_VAL_SEC = TCO_VAL_SEC

@over REC_VAL_SEC_TCO[ce2, s] = Ttco[ce2] * EMS_SEC[ce2, s] * (1 - EXO[ce2, s])
@over REC_VAL_SEC_ETS[ce2, s] = PE_signal_ETS * PCH * EMS_SEC[ce2, s] * EXO[ce2, s] where s in %list_ETS
@over REC_VAL_SEC_ETS2[ce2, s] = ETS2[s] * PCH * EMS_SEC[ce2, s] * (1 - EXO[ce2, s]) where s in %list_ETS2

ETS2[s] = ETSexo2[s] where s in %list_ETS2
ETS2_hh[ce2] = ETSexo2_hh[ce2]

REC_VAL_SEC_TCO[s] = sum(REC_VAL_SEC_TCO[ce2, s] on ce2)
REC_VAL_SEC_ETS[s] = sum(REC_VAL_SEC_ETS[ce2, s] on ce2) where s in %list_ETS
REC_VAL_SEC_ETS2[s] = sum(REC_VAL_SEC_ETS2[ce2, s] on ce2) where s in %list_ETS2

REC_VAL_SEC_TCO = sum(REC_VAL_SEC_TCO[s] on s)
REC_VAL_SEC_ETS = sum(REC_VAL_SEC_ETS[sets] on sets)
REC_VAL_SEC_ETS2 = sum(REC_VAL_SEC_ETS2[sets2] on sets2)

REC_VAL_TCO_HH[ce2] = ttco[ce2] * ems_hh[ce2, h]
REC_VAL_TCO_HH = sum(REC_VAL_TCO_HH[ce2] on ce2)
REC_VAL_ETS2_HH[ce2] = ETS2_hh[ce2] * pch * ems_hh[ce2, h]
REC_VAL_ETS2_HH = sum(REC_VAL_ETS2_HH[ce2] on ce2)

REDIS_VAL_TCO_H = REC_VAL_TCO_HH

REDIS_VAL_SEC_TCO = REC_VAL_SEC_TCO
REDIS_VAL_SEC_TCO[s] = REC_VAL_SEC_TCO[s]

REDIS_VAL_SEC_ETS = REC_VAL_SEC_ETS
REDIS_VAL_SEC_ETS[s] = REC_VAL_SEC_ETS[s] where s in %list_ETS

REDIS_VAL_ETS2_H = REC_VAL_ETS2_HH

REDIS_VAL_SEC_ETS2 = REC_VAL_SEC_ETS2
REDIS_VAL_SEC_ETS2[s] = REC_VAL_SEC_ETS2[s] where s in %list_ETS

@over DEP_VAL = CL_S[sp]*L_S[sp]*PROG_L[sp] + R_G{-1}*DEBT_G_VAL{-1} + PRESOC_VAL + SUB_RENOV_VAL + SUB_AUTO_VAL + REDIS_VAL_TCO_H + REDIS_VAL_SEC_TCO _
                + REDIS_VAL_SEC_ETS + REDIS_VAL_ETS2_H + REDIS_VAL_SEC_ETS2 + value(E[sp] + MAT[sp] + IY[sp] + IA[sp] _
				+ (G - G[sp]) - ((SUB - SUB_01) + (SY - SY_01))) 

@over REC_VAL  = DIV_GOV_VAL  + IR_VAL  + AIC_VAL  + INC_GOV_OTH_net  - CL_S_20  * L_S_20  * PROG_L_20  + PY_20  * Y_20  + PTAX  * TAX  + PIY  * IY _
                 + PIS  * IS  + PCSE_TOT  * CSE_TOT  + PCSS_TOT  * CSS_TOT  - ( PE_20  * E_20  + PMAT_20  * MAT_20  + PIY_20  * IY_20 ) _ 
				 + REC_VAL_SEC_ETS + REC_VAL_SEC_ETS2 + REC_VAL_ETS2_HH + REC_VAL_TCO_HH + REC_VAL_SEC_TCO

## option 1 MENAGES ET ENTREPRISES ##

@over d(TIR[h]) = -d((choc_IR)/ DISPINC_AI_VAL[h]) + d(TIR_TREND)
@over DISPINC_VAL[h]  = DISPINC_AI_VAL[h]  - IR_VAL[h] - AIC_VAL[h]  + REDIS_VAL_TCO_H + REDIS_VAL_ETS2_H + SUB_AUTO_VAL  + SUB_RENOV_VAL
#@over d(TIR[h]) = -d( (PHI_TCO[h] * TCO_VAL_HH + REDIS_VAL_SEC)/ DISPINC_AI_VAL[h]) + d(TIR_TREND)
#@over d(TIR[h]) = (@year<=2020) * (-d((PHI_TCO[h] * TCO_VAL_HH + REDIS_VAL_SEC)/ DISPINC_AI_VAL[h])) + (@year>2020) * (-d((PHI_TCO[h] * TCO_VAL_HH )/ DISPINC_AI_VAL[h])) + d(TIR_TREND)

#@over TIS[s] = TIS_exo[s] - (0 * REDIS_VAL_SEC{-1}*PY[s]{-1}*Y[s]{-1}/(PY{-1}*Y{-1}) + TAX_CR_VAL[s])/(PRF[s]{-1} * RF[s]{-1} +0.0000001)
#@over TIS[s] = TIS_exo[s] - (TCO_VAL_SEC[s]{-1} + TAX_CR_VAL[s])/(PRF[s]{-1} * RF[s]{-1} +0.0000001)
@over TIS[s] = TIS_exo[s] - (choc_IS[s]+ TAX_CR_VAL[s])/(PRF[s]{-1} * RF[s]{-1} +0.0000001) 

@over RF_net[s] = @elem(PRF[s]{-1},%baseyear) * RF[s]{-1} - IS[s] + (@year>2020) * (REDIS_VAL_SEC_TCO[s]{-1} + REC_VAL_SEC_ETS[s]{-1} + REDIS_VAL_SEC_ETS2[s]{-1})/PCH{-1}) if RF_net[s] <> 0
@over PRF_net[s] * RF_net[s] = PRF[s]{-1} * RF[s]{-1} - PIS[s] * IS[s] + (REDIS_VAL_SEC_TCO[s]{-1} + REDIS_VAL_SEC_ETS[s]{-1} + REDIS_VAL_SEC_ETS2[s]{-1}) if RF_net[s] <> 0

## option 2 MENAGES UNIQUEMENT ##

#@over d(TIR[h]) = -d((PHI_TCO[h] * REDIS_VAL_H + REDIS_VAL_SEC_TCO + choc_IR)/ DISPINC_AI_VAL[h]) + d(TIR_TREND)
#@over RF_net[s] = @elem(PRF[s]{-1},%baseyear) * RF[s]{-1} - IS[s] if RF_net[s] <> 0
#@over PRF_net[s] * RF_net[s] = PRF[s]{-1} * RF[s]{-1} - PIS[s] * IS[s] if RF_net[s] <> 0

## option 3 PAS DE REDISTRIBUTION ##

#@over d(TIR[h]) = -d((choc_IR)/ DISPINC_AI_VAL[h]) + d(TIR_TREND)
#@over RF_net[s] = @elem(PRF[s]{-1},%baseyear) * RF[s]{-1} - IS[s] if RF_net[s] <> 0
#@over PRF_net[s] * RF_net[s] = PRF[s]{-1} * RF[s]{-1} - PIS[s] * IS[s] if RF_net[s] <> 0
#@over DISPINC_VAL[h]  = DISPINC_AI_VAL[h]  - IR_VAL[h] - AIC_VAL[h] + SUB_AUTO_VAL  + SUB_RENOV_VAL
#@over DEP_VAL = CL_S[sp]*L_S[sp]*PROG_L[sp] + R_G{-1}*DEBT_G_VAL{-1} + PRESOC_VAL + SUB_RENOV_VAL + SUB_AUTO_VAL _
#                + value(E[sp] + MAT[sp] + IY[sp] + IA[sp] + (G - G[sp]) - ((SUB - SUB_01) + (SY - SY_01))) 

## option 4 MENAGE ET ENTREPRISES (TCSE) ##

#@over d(TIR[h]) = -d((choc_IR)/ DISPINC_AI_VAL[h]) + d(TIR_TREND)
#@over DISPINC_VAL[h]  = DISPINC_AI_VAL[h]  - IR_VAL[h] - AIC_VAL[h]  + REDIS_VAL_TCO_H  + SUB_AUTO_VAL  + SUB_RENOV_VAL
#@over TIS[s] = TIS_exo[s] - (choc_IS{-1}*PY[s]{-1}*Y[s]{-1}/(PY{-1}*Y{-1}) + TAX_CR_VAL[s])/(PRF[s]{-1} * RF[s]{-1} +0.0000001) 
#@over RF_net[s] = @elem(PRF[s]{-1},%baseyear) * RF[s]{-1} - IS[s] if RF_net[s] <> 0
#@over PRF_net[s] * RF_net[s] = PRF[s]{-1} * RF[s]{-1} - PIS[s] * IS[s] if RF_net[s] <> 0
#@over TCSE[s] = @elem(TCSE[s], %baseyear) - REDIS_VAL_SEC_TCO{-1}/(W_S{-1} * L_S{-1})

@over PENERTD[ce] * ENERTD[ce] = TTICD[ce] * YQ[ce] if ENERTD[ce] <> 0 ## pourquoi les taxes energetiques ne sont-elles pas calculees par rapport a la production en prix courants PYQ * YQ comme les autres taxes ? # parce que ce sont des assises en volume. 
@over PENERTM[ce] * ENERTM[ce] = TTICM[ce] * M[ce] if ENERTM[ce] <> 0 ## idem
@over YQ[ce] * PYQ[ce] = PQD[ce] * QD[ce] - PVATD[ce] * VATD[ce] - POTHTD[ce] * OTHTD[ce] - PSUBD[ce] * SUBD[ce] - (PMCD[ce] * MCD[ce] + PMTD[ce] * MTD[ce]) - PENERTD[ce] * ENERTD[ce] - TCO_VALD[ce] if YQ[ce] <> 0
@over M[ce] * PM[ce] = PQM[ce] * QM[ce] - PVATM[ce] * VATM[ce] - POTHTM[ce] * OTHTM[ce] - PSUBM[ce] * SUBM[ce] - (PMCM[ce] * MCM[ce] + PMTM[ce] * MTM[ce]) - PENERTM[ce] * ENERTM[ce] - TCO_VALM[ce] if M[ce] <> 0
@over PYQS[ce]  * YQS[ce]  = PYQ[ce]  * YQ[ce]  + POTHTD[ce]  * OTHTD[ce]  + PENERTD[ce]  * ENERTD[ce]  + PSUBD[ce]  * SUBD[ce]  + PMTD[ce]  * MTD[ce]  + PMCD[ce]  * MCD[ce] + TCO_VALD[ce] if YQS[ce] <> 0
@over PMS[ce]  * MS[ce]  = PM[ce]  * M[ce]  + POTHTM[ce]  * OTHTM[ce]  + PENERTM[ce]  * ENERTM[ce]  + PSUBM[ce]  * SUBM[ce]  + PMTM[ce]  * MTM[ce]  + PMCM[ce]  * MCM[ce] + TCO_VALM[ce] if MS[ce] <> 0

@over PGDPter  * GDPter  = PVA  * VA  + PTAX  * TAX  + PSUB  * SUB + REC_VAL_TCO_HH + REC_VAL_ETS2_HH + REC_VAL_SEC_TCO + REC_VAL_SEC_ETS + REC_VAL_SEC_ETS2


# pour �viter le double compte des choc_g[s] qui �taient � la fois dans EXPG (on le retire) et dans EXP_G[s]
@over EXPG = ( 1 + ADJUST(69,1)*(d(log(EXPG_trend)) - STEADYSTATE(62,1)*(DP_G_VAL - DP_G_VAL_n)*PGDP{-1}*GDP{-1} / (PG{-1}*EXPG{-1})) +   (1-ADJUST(69,1))*dlog(EXPG{-1}))*EXPG{-1}


##############################################################

########################### RUN3 #############################

##############################################################


#### MODIFICATIONS CEE (subvention priv�e financ�e par une taxe priv�e) #### 

# Champ b�n�ficiaires de la subvention = m�nages uniquement (� v�rifier DGEC)
# Champ oblig�s = fournisseurs d'�nergie
# Champ de la taxe = tous les consommateurs d'�nergie (m�nages, entreprises), industrie exon�r�e

## 1/ Versement d'une subvention priv�e par les fournisseurs d'�nergie

# Subvention priv�e de CEE re�ue par les m�nages (les m�nages ne re�oivent que 75% du budget, le reste �tant des frais commerciaux)
subvention_resid_CEE = CEE 
@over R_SUB_CEE[h,ecl,ecl2] * RENOV_VAL = subvention_resid_CEE

# Subvention priv�e de CEE re�ue par l'industrie
subvention_indus_CEE = subvention_resid_CEE * part_CEE_industrie / part_CEE_residentiel
R_SUB_CEE_indus = subvention_indus_CEE /((sum(I_MDE[sinc] * PIA[sinc] on sinc)))
R_SUB_CEE[sinc] = R_SUB_CEE_indus if I_MDE[sinc]>0

# Subvention priv�e de CEE re�ue par le tertiaire
subvention_tertiaire_CEE = subvention_resid_CEE * part_CEE_tertiaire / part_CEE_residentiel
R_SUB_CEE_tertiaire = subvention_tertiaire_CEE /((I_MDE_19*PIA_19 + I_MDE_20*PIA_20)) 
R_SUB_CEE_19 = R_SUB_CEE_tertiaire if I_MDE_19>0
R_SUB_CEE_20 = R_SUB_CEE_tertiaire if I_MDE_20>0

# Subvention priv�e de CEE re�ue par les transports
subvention_transp_CEE = subvention_resid_CEE * part_CEE_transport / part_CEE_residentiel
R_SUB_CEE_transp = subvention_transp_CEE /((sum(I_MDE[trsp]*PIA[trsp] on trsp)))
R_SUB_CEE[trsp] = R_SUB_CEE_transp  if I_MDE[trsp]>0

# Subvention priv�e de CEE re�ue par l'agriculture
subvention_agri_CEE = subvention_resid_CEE * part_CEE_agriculture / part_CEE_residentiel
R_SUB_CEE_agri = subvention_agri_CEE /(I_MDE_01*PIA_01) if I_MDE_01>0
R_SUB_CEE_01 = R_SUB_CEE_agri  if I_MDE_01>0

# on ignore pour l'instant les subventions vers�es aux r�seaux de chaleur (confondu avec gaz). 

# int�gration � l'�quation de co�t du capital de d�carbonation
CK_subE[sne] = R_SUB_CEE[sne]
# Les CEE peuvent permettre � la fois des gains d'efficacit� �nerg�tique et de la substitution d'�nergi ecarbon�e � non carbon�e (dans le cas des PAC par exemple). Pour l'instant on ne mod�lise que des gains d'efficacit� energ�tique.

# Suventions totales vers�es
subvention_CEE = subvention_resid_CEE + subvention_indus_CEE + subvention_tertiaire_CEE + subvention_transp_CEE + subvention_agri_CEE

## 2/ Int�gration de la subvention vers�e comme une charge pour les fournisseurs d'�nergie

#Production d'�nergie des secteurs �nerg�tiques
Y_ce[se] = sum(Y[ce,se] on ce) #les secteurs �nerg�tiques produisent parfois des biens non �nerg�tiques. ET les secteurs non �nerg�tiques produisent parfois des biens �nerg�tiqes. 
Y_ce = sum(Y_ce[se] on se)
PY_ce[se]*Y_ce[se] = sum(PY[se]*Y[ce,se] on ce) #les secteurs �nerg�tiques produisent parfois des biens non �nerg�tiques

# Allocation des obligations de CEE entre fournisseurs d'�nergie au prorata de leurs parts de march� de la demande domestique
@over Phi_CEE[se] = Y_ce[se] / Y_ce 
# en th�orie les obligations de CEE sont fix�es par fournisseurs d'�nergie au prorata de: 
# - leurs ventes de carburant routier
# - leurs ventes d'autres types d'�nergie aux m�nages et au tertiaire (20+19) 
# simplification -> au prorata de leurs ventes totales d'�nergie.
# Id�alement il faudrait exclure les ventes � l'�tranger (exportations)

subvention_CEE_versee[se] = subvention_CEE * Phi_CEE[se]

# retrait des CEE du calcul des co�ts unitaires et des taux de marge - focus sur le comportement "�conomique" hors CEE des entreprises
@over PE_CEE[se] = 0.0001
@over PE_CEE_n[se] = 0.0001
# retir� aussi des termes de substitution, v�rifier si ok.

# int�gration des charges de CEE vers�s dans le r�sultat financier de l'entreprise -> neutre pour l'entreprise (charges de subvention vers�e et de frais commerciaux compens�s en hausse de co�t)

## 3/ Calcul d'une taxe priv�e par les fournisseurs d'�nergie sur les prix de l'�nergie pour couvrir le co�t des CEE. La taxe est sup�rieure au co�t des subventions, environ 25% �tant capt�s par des frais et marges.

#montant de taxe � pr�lever par le secteur �nerg�tique sur ses ventes (augment�e des frais commerciaux)
@over CEE[se] = 0.0001
taxe_CEE =(subvention_CEE/(1-part_frais_CEE))
taxe_CEE[se] = taxe_CEE  * Phi_CEE[se]

#taxe pr�lev�e par le secteur �nerg�tique sur chaque bien �nerg�tique qu'il produit
taxe_CEE[ce,se] = taxe_CEE[se] * (PY[se]*Y[ce,se])/(PY_ce[se]*Y_ce[se]) if Y_ce[se]<>0

#taxe du secteur ventil�e par produit �nerg�tique au pro-rata de part du produit dans production d'�nergie du secteur 

# taxe pay�e par le consommateur sur chaque bien �nerg�tique
taxe_CEE_conso[ce] = sum(taxe_CEE[ce,se] on se)

#ajout de la taxe dans le prix de vente de l'�nergie
# Prix pour tous les types de consommation (interm�diaire, finale...)
@over PYQ[c] * YQ[c] = sum(PY[s] * Y[c, s] if Y[c, s] <> 0 on s) + taxe_CEE_conso[c] if YQ[c] <> 0
# la taxe est enti�rement comptabilis�e en prix. transmission encore � PYQS/PYQS_BTCO 

## 4/ Correction de la ventilation de la taxe CEE par poste de la demande de chaque bien �nerg�tique en tenant compte de l'exon�ration de l'industrie de la contribution CEE 
# r�allocation neutre pour le producteur d'�nergie [se] et neutre pour les quantit�s produites de chaque �nergie [ce]

# en th�orie la contribution CEE sur les prix de n'�nergie est pay�e par: 
# - tous les consommateurs sur les ventes de carburant routier
# - les m�nages et au tertiaire (20+19) sur leurs autres consommations d'�nergie  
# simplification -> on exon�re l'industrie et la construction sur leurs CI. On garde les CI des transport dans l'assiette sous l'hypoth�se que l'essentiel de leurs CI sont du carburant routier. 
# que faire pour agriculture. On la garde dans les payeurs pour l'instant.

# Calcul de la demande de biens �nerg�tiques hors CI de l'industrie (pour info)
CID_horsexo_CEE[ce] = (sum(CID[ce,s_no_indus] on s_no_indus)) 
CID_horsexo_CEE[cm] = CID[cm]  
QD_horsexo_CEE[c] = QD[c] - CID[c] + CID_horsexo_CEE[c] # v�rifier
PCID_horsexo_CEE[ce]*CID_horsexo_CEE[ce] = sum(CID[ce,s_no_indus] * PCID[ce,s_no_indus]  on s_no_indus)
PCID_horsexo_CEE[cm]=PCID[cm]
PQD_horsexo_CEE[c]*QD_horsexo_CEE[c] = QD[c]*PQD[c] - CID[c]*PCID[c] + CID_horsexo_CEE[c]*PCID_horsexo_CEE[c]
# les CI �nergie repr�sentent 54 % de la demande d'�nergie produite domestiquement
# les CI �nergie de l'industrie repr�sentent 12 % de la demande d'�nergie produite domestiquement

# calcul des montants d'exon�ration de contribution CEE par poste de demande

# CI des secteurs industriels + construction
exo_taxe_CEE_ED[ce,sind] = taxe_CEE_conso[ce] * (PED[ce,sind] * ED[ce,sind]* (1 + @elem(TvatDoth[ce], %baseyear))/(1 + TvatDoth[ce]))/(PYQS[ce]* YQS[ce]) 
exo_taxe_CEE_ED[ce] = sum(exo_taxe_CEE_ED[ce,sind] on sind)
# prorata calcul� avec des variables avant TVA -> il n'exise pas de variable avant TVA par poste de demande donc calcul� ici � partir de ED. Approximation du prorata sur PYQ avec prorata sur PYQS sous l'hypoth�se que la taxe CEE est ind�pendante des marges de transport/commerciales etc et donc affecte PYQ et PYQS du m�me montant.
# Exportations
exo_taxe_CEE_XD[ce] = taxe_CEE_conso[ce] * (PXD[ce] * XD[ce])/(PYQS[ce]* YQS[ce])  #pas d'imposition des X � la TVA 
# Variations de stocks
exo_taxe_CEE_DSD[ce] = taxe_CEE_conso[ce] * (PDSD[ce] * DSD[ce])/(PYQS[ce]* YQS[ce])  #pas d'imposition des variations de stocks � la TVA 
# montant total exon�r�
exo_taxe_CEE[ce] = exo_taxe_CEE_ED[ce]  + exo_taxe_CEE_XD[ce] + exo_taxe_CEE_DSD[ce]

# retrait des exon�rations des prix des postes de demande concern�s

# CI des secteurs industriels + construction
@over PED[ce,sind] * ED[ce,sind] = (PYQS_BTCO[ce] * ED[ce,sind] + TCO_VALD[ce,sind] - exo_taxe_CEE_ED[ce,sind]) * (1 + TvatDoth[ce]) / (1 + @elem(TvatDoth[ce], %baseyear))   if ED[ce,sind] > 0
#PYQS_BTCO =  Energy consumption price before carbon tax

# Exportations
@over dlog(PXD[ce])  = dlog((PYQS[ce]*YQS[ce] - taxe_CEE_conso[ce])/YQS[ce]) #comme on a PXD = PYQS (le prix composite, agr�geant tous postes de demande) alors on retire la taxe totale directement

# Variations de stocks
@over PDSD[ce] = (PYQS[ce]*YQS[ce] - taxe_CEE_conso[ce])/YQS[ce] #idem

# correction de la taxe � la hausse pour les autres postes de demande (compensation des exon�rations)
corr_taxe_CEE[ce] = exo_taxe_CEE[ce]/(YQS[ce]*PYQS[ce]) if YQS[ce]<>0

#consommations �nerg�tiques des secteurs hors industrie
@over PED[ce,s_no_indus] * ED[ce,s_no_indus] = (PYQS_BTCO[ce]*(1 + corr_taxe_CEE[ce])* ED[ce,s_no_indus] +TCO_VALD[ce,s_no_indus]) * (1 + TvatDoth[ce]) / (1 + @elem(TvatDoth[ce], %baseyear))   if ED[ce,s_no_indus] > 0
# remarque: bizarre de multiplier un prix avant TVA (PYQS_BTCO) par un volume ap TVA (ED)

# taxe  incluse dans PED[ce] via PYQS, besoin de corriger (retrait des taxes exon�r�es et correction � la hausse des taxes sur les autres sercteurs).
@over PED[ce] = PYQS[ce] *(1 + corr_taxe_CEE[ce])* (( 1 + TvatDoth[ce] ) / ( 1 + @elem(TvatDoth[ce], 2006) ))

# consommation finale des m�nages
@over PCHD[ce] = (PYQS[ce])*(1 + corr_taxe_CEE[ce])*(( 1 + TvatD[ce] ) / ( 1 + @elem(TvatD[ce], 2006) ))

#consommation publique de gaz
@over PGD[ce]  = (PYQS[ce]) *(1+corr_taxe_CEE[ce])* ( ( 1  + TvatDoth[ce] )  / ( 1  + @elem(TvatDoth[ce] , 2006) ) )

#pas de conso de biens �nerg�tiques pour investissement

#calcul du taux de taxe CEE par secteur �nerg�tique (pour info) - avant TVA et marges transport/comm
taux_CEE_sec[se] = taxe_CEE[se]/(PY_ce[se]*Y_ce[se])  if Y[se] <> 0

#calcul du taux de taxe CEE par bien �nerg�tique - avant TVA et marges transport/comm
taux_CEE_conso[ce] = taxe_CEE_conso[ce]/(PYQ[ce]*YQ[ce])  if YQ[ce] <> 0

# enregistrement de frais commerciaux en CI du bien 19

MAT_comm_cee[se] = (taxe_CEE[se] * part_frais_CEE)/PY[se] # quel d�flateur?
@over d(log(MAT_n_21))  = d(log(Y_21))  + d(SUBST_MAT_21) + d(MAT_comm_cee_21)/MAT_n_21{-1}
@over d(log(MAT_n_2201))  = d(log(Y_2201))  + d(SUBST_MAT_2201) + d(MAT_comm_cee_2201)/MAT_n_2201{-1}
@over d(log(MAT_n_2202))  = d(log(Y_2202))  + d(SUBST_MAT_2202)+ d(MAT_comm_cee_2202)/MAT_n_2202{-1}
@over  d(log(MAT_n[se24]))  = d(log(Y[se24]))  + d(SUBST_MAT[se24]) + choc_MAT[se24]  + d(MAT_comm_cee[se24])/MAT_n[se24]{-1}

# les CI des secteurs �lectriques sont exogenes apr�s 2021 est-ce qu'on modifie? 
@over  d(log(MAT_n[se23]))  = (@year< 2021)*(d(log(Y[se23]))  + d(SUBST_MAT[se23])) + (@year>= 2021)* dlog(OPEX_target[se23]*Q_mtep_ef[se23]/0.086)  + d(MAT_comm_cee[se23])/MAT_n[se23]{-1}

# on consid�re que les frais commerciaux sont tous pass�s en CI de services marchands

# retrait des autres CI
@over d(log(MAT[cm, se])) = d(log(MAT[se] - MAT_comm_cee[se])) + d(SUBST_MAT[cm, se]) if MAT[cm, se] <> 0
@over d(log(MAT[19, se])) = d(log(MAT[se] - MAT_comm_cee[se])) + d(SUBST_MAT[19, se]) + d(MAT_comm_cee[se])/MAT[19, se]{-1} if MAT[19, se] <> 0
# pour info MAT[s] pas totalement index� sur MAT_n[s] : log(MAT_2307)  = ADJUST(1  + 3 , 1)  * log(MAT_n_2307)  + ( 1  - ADJUST(1  + 3 , 1) )  * ( log(MAT_2307{-1})  + d(log(MAT_e_2307)) )
# les CI de services marchands des secteurs �nerg�tiques font +16%


##### SUBVENTIONS POUR L'INVESTISSEMENT EN DECARBONATION DES ENTREPRISES (CEE et CI EE industrie) #####

# @over CK[s] = PIA[s] * (  R[s] - d(P)/P{-1} + Tdec[s]) if K[s] > 0 Erreur correction ADEME plus haut : il faut remplacer le terme PIA par Pk qui est la moyenne pond�r�e des PIA*[t]*IA[t] net du d�classement sur le pass�.

CK_E[sne] = (1-CK_subE[sne]) * PIA[sne] * (  R[sne] - d(P)/P{-1} + Tdec[sne]) if K[sne] > 0

 @over d(SUBST_K_E_n[sne]) = _
     -0 * d(log(CK_E[sne]/PROG_K[sne]) - log(CL[sne]))                    * phi_l_bis[sne]{-1} _
     -eta_K_E[sne]      * d(log(CK_E[sne]/PROG_K[sne]) - log((PE[sne] + PE_signal[sne] + PE_CEE[sne] + PE_signal_bis[sne] + PE_signal_E[sne])/PROG_E[sne]))   * phi_e_bis[sne]{-1} _
     -0 * d(log(CK_E[sne]/PROG_K[sne]) - log(PMAT[sne]))                  * phi_mat_bis[sne]{-1} _
   if K_n[sne] <> 0 where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

    @over d(SUBST_E_n[s]) = _
     -eta_K_E[s]     * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s] + PE_signal_E[s])/PROG_E[s]) - log(CK[s]/PROG_K[s]))   * phi_k_ne_bis[s]{-1} _
	 -eta_K_E[s]     * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s] + PE_signal_E[s])/PROG_E[s]) - log(CK_e[s]/PROG_K[s]))   * phi_k_e_bis[s]{-1} _
     -eta_L_E[s]     * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s]) - log(CL[s]))   * phi_l_bis[s]{-1} _
     -ES_KLEM($s, 6) * d(log((PE[s] + PE_Signal[s] + PE_CEE[s] + PE_signal_bis[s])/PROG_E[s]) - log(PMAT[s])) * phi_mat_bis[s]{-1} _
   if E_n[s] <> 0 where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
   
phi_n_K_E[sne] = K_E_n[sne] * CK_E[sne] / (K_E_n[sne] * CK_E[sne] + K_NE_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne]) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
phi_n_K_NE[sne] = K_NE_n[sne] * CK[sne] / (K_E_n[sne] * CK_E[sne] + K_NE_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne]) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
@over phi_n_L[sne] = L_n[sne] * PROG_L[sne] * CL[sne] / (K_E_n[sne] * CK_E[sne] + K_NE_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne]) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
@over phi_n_E[sne] = (E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne])) / (K_E_n[sne] * CK_E[sne] + K_NE_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne]) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
@over phi_n_MAT[sne] = MAT_n[sne] * PMAT[sne] / (K_E_n[sne] * CK_E[sne] + K_NE_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * (PE[sne] + PE_CEE_n[sne] + PE_signal_bis[sne]) + MAT_n[sne] * PMAT[sne]) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

K_E[s] = (1 - tdec[s])*K_E[s]{-1} + I_MDE[s] where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

phi_K_ne_bis[s] = (K[s] - K_E[s]) * CK[s] / ((K[s] - K_E[s])  * CK[s]+ K_E[s]  * CK_e[s]  + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s]) where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
phi_K_e_bis[s] = K_E[s] * CK_e[s] / ((K[s] - K_E[s])  * CK[s]+ K_E[s]  * CK_e[s]  + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s]) where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
@over phi_L_bis[s] = L[s] * PROG_L[s] * CL[s] / ((K[s] - K_E[s])  * CK[s]+ K_E[s]  * CK_e[s]  + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s]) where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
@over phi_E_bis[s] = (E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s])) / ((K[s] - K_E[s])  * CK[s]+ K_E[s]  * CK_e[s]  + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s]) where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20
@over phi_MAT_bis[s] = MAT[s] * PMAT[s] / ((K[s] - K_E[s])  * CK[s]+ K_E[s]  * CK_e[s]  + L[s] * PROG_L[s] * CL[s] + E[s] * (PE[s] + PE_CEE[s] + PE_signal_bis[s]) + MAT[s] * PMAT[s]) where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over d(log(CU_n_bis[s])) = phi_n_K_E[s]{-1} * d(log(CK_E[s]/PROG_K[s])) + phi_n_K_NE[s]{-1} * d(log(CK[s]/PROG_K[s])) + phi_n_l[s]{-1} * d(log(CL[s])) + phi_n_e[s]{-1} * d(log((PE[s] + PE_CEE_n[s] + PE_signal_bis[s])/PROG_E[s])) + phi_n_mat[s]{-1} * d(log(PMAT[s])) if Y[s] > 0 where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over CU_n_des[s] * Y[s] = CK_E[s] * K_E_n[s] + CK[s] * K_NE_n[s] + CL[s] * L_n[s] * PROG_L[s] + (PE[s] + PE_CEE_n[s] + PE_signal_bis[s]) * E_n[s] + PMAT[s] * MAT_n[s] if Y[s] > 0 where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over d(log(YCAP[sne])) = phi_n_L[sne]{-1} * d(log(L_n[sne] * PROG_L[sne]) ) + phi_n_K_E[sne]{-1} * d(log(K_E_n[sne] * PROG_K[sne]) ) + phi_n_K_NE[sne]{-1} * d(log(K_NE_n[sne] * PROG_K[sne]) ) + phi_n_E[sne]{-1} * d(log(E_n[sne] * PROG_E[sne]) ) + phi_n_MAT[sne]{-1} * d(log(MAT_n[sne]) ) if YCAP[sne] <> 0 where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

k_e_n_init[sne] = (@year <= 2023) * ((1 - tdec[sne])*k_e_n_init[sne]{-1} + I_MDE_notionnel[sne] + IMP_BUD_niv_MDE[sne]) + (@year > 2023) * (k_e_n_init[sne]{-1}) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

prog_e_learning[sne] = (k_e_n[sne]/k_e_n_init[sne])^(theta_learning[sne]) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over GR_PROG_E[sne] = alpha_PROG_E[sne] + alpha_PROG_E_PE * (log(PE[sne]) - log(PCH) > 0) * (d(log(PE[sne])) - d(log(PCH))) + (d(log(prog_e_learning[sne])) > 0) * d(log(prog_e_learning[sne])) where sne in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

# mod�liser les CEE des secteurs 15 et 16 APRES avoir v�rifi� la mod�lisation des mesures de ces secteurs.


#### INVESTISSEMENTS EN EFFICACITE ENERGETIQUE  ####


# modification en ligne avec les changements sur les CK et CK_e

@over d(log(IA_notionnel_noshock[s])) = d(log(Y[s])) - d(log(PROG_K[s]))  +  d(SUBST_K_NE[s]) if IA_n[s] <> 0 where s in 01 02 04 05 06 07 08 09 10 11 12 13 14 17 18 19 20

@over d(log(IA_notionnel_noshock_03))  = dlog(Y_03_corr)  + d(SUBST_K_NE_03)  - dlog(PROG_K_03)

@over d(log(IA_n_des[s]))  = d(IMP_BUD_niv_bis[s]) + ( ADJUST(1  , 1)  * dlog(IA_n_des[s]{-1})  + 1.8  * dlog(Y[s]) + 0.28  * ( log(IA_notionnel[s]{-1}) + IMP_BUD_niv_bis[s]{-1} - log(IA_n_des[s]{-1}) ) + ( 0*d(SUBST_K_NE[s])) ) if IA_n[s] <> 0 where s in 01 02 04 05 06 07 08 09 10 11 12 13 15 16 17 18 19 20

@over d(log(IA_n_des_03))  = d(IMP_BUD_niv_bis_03)  + ( ADJUST(1  , 1)  * dlog(IA_n_des_03{-1})  + 1.8  * dlog(Y_03_corr)  + 0.28  * ( log(IA_notionnel_03{-1})  + IMP_BUD_niv_bis_03{-1}  - log(IA_n_des_03{-1}) )  + ADJUST(1  , 4)  * 0  * d(SUBST_K_NE_03) )


@over d(log(I_NE_n[s])) = ( @year <= 2019 )  * ( ( IAexo[s] > 0 )  * ( dlog(IAexo[s]-I_MDE[s]) ) )  + ( @year > 2019 )  * (d(log(IA_n_des[s]))) if IA_n[s] <> 0 where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over K_NE_n[s] = (1 - tdec[s])*K_NE_n[s]{-1} + IA_notionnel[s] + IMP_BUD_niv[s] where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20


d(log(I_MDE_notionnel[s])) = d(log(Y[s])) - d(log(PROG_K[s])) + d(SUBST_K_E[s]) where s in 01 02 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over d(log(I_MDE_notionnel_03)) = d(log(Y_03_corr)) - d(log(PROG_K_03)) + d(SUBST_K_E_03) 

@over d(log(I_MDE[s])) =  d(I_MDE_shock_exo[s]) + ADJUST(1  , 1)  * dlog(I_MDE[s]{-1})  + 1.8  * dlog(Y[s])  + 0.28 * (log(I_MDE_notionnel[s]{-1}) + I_MDE_shock_exo[s]{-1} - log(I_MDE[s]{-1}))  + ADJUST(1  , 4)  * 0 * d(SUBST_K_E[s]) where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

@over d(log(I_MDE_03)) =  d(I_MDE_shock_exo_03) + ADJUST(1  , 1)  * dlog(I_MDE_03{-1})  + 1.8  * dlog(Y_03_corr)  + 0.28 * (log(I_MDE_notionnel_03{-1}) + I_MDE_shock_exo_03{-1} - log(I_MDE_03{-1}))  + ADJUST(1  , 4)  * 0 * d(SUBST_K_E_03) 

@over K_E_n[s] = (1 - tdec[s])*K_E_n[s]{-1} + I_MDE_notionnel[s] + IMP_BUD_niv_MDE[s] where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20

#@over K_E_n_15 = PTrucks_15 * Trucks_15

#@over K_E_n_16 = PTrucks_16 * Trucks_16 + PLUV_16 * LUV_16

@over K_n[s] = K_NE_n[s] + K_E_n[s] where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20 # correction ADEME 

@over IA_n[s] = I_NE_n[s] + I_MDE[s] where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 19 20 # correction ADEME

@over IA_n_19 = I_NE_n_19 + I_MDE_19 + (@year>2019) * (Inv_IRVE-@elem(Inv_IRVE, 2019)) + sobre_19 * IA_n_19{-1}

#@over  K_NE_des_n[s] = K_NE_des_n[s]{-1}*(1 + d(Y[s])/Y[s]{-1} - d(PROG_K[s])/prog_K[s]{-1} + IMP_BUD[s] * @elem(GDP, %baseyear) / @elem(K_n[s], %baseyear) + Choc_CSC[s] + d(SUBST_K_NE[s])) if K_NE_n[s] <> 0 where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18

#@over  K_E_des_n[s] = K_E_des_n[s]{-1}*(1 + d(Y[s])/Y[s]{-1} - d(PROG_K[s])/prog_K[s]{-1} + IMP_BUD[s] * @elem(GDP, %baseyear) / @elem(K_n[s], %baseyear) + d(SUBST_K_E[s]))  if K_E_n[s] <> 0 where s in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18


