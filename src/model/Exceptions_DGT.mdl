 @over CHD[cservex]  = ((EXP[cservex]-CHM[cservex] > 0) * (EXP[cservex] - CHM[cservex]) + (EXPexo[cservex] - CHM[cservex] =< 0) * (0.00001))*(@year<=2019) _
