                    + ((EXP[cepeg] - CHM[cepeg]>0)*(EXP[cepeg] - CHM[cepeg])+(EXP[cepeg] - CHM[cepeg]<=0)*0.00001)*(@year>2019) if CHD[cepeg] <> 0

 CH_bis_dgt[cepeg] = CHD[cepeg] + CHM[cepeg]
