################# Evaluation macro du fonds chaleur

############# hausse de la production de biogaz, biomasse, cog�n�ration et UIOM etc au d�triment du gaz naturel dans les reseaux de chaleur (hors industrie)

### on a : 

#Y_24[se24]  = PhiY_24[se24]  * YQ_24

#PhiY_24[se24]  = PhiY_ef_tot_24[se24]  * ( 1  - ( 0  + PhiY_24_01 ) )

#PhiY_ef_tot_24[se24]  = Q_Mtep_ef_tot_24[se24]  / Q_Mtep_ef_tot_SOU_24

#Q_Mtep_ef_tot_24[se24]  = Q_Mtep_ef_24[se24]  + Q_Mtep_X_24[se24]  + Q_Mtep_Nener_24[se24]  - Q_Mtep_in_24[se24]  + Q_Mtep_out_24[se24]

#Q_Mtep_ef_24[se24]  = Q_Mtep_ef_SOU_24  * PhiY_ener_24[se24]

# on endog�n�ise PhiY_ener_24[se24]

phiy_E[ce,se] = PhiY_ener_exo[ce,se] + Q_Mtep_FC[se]  / Q_Mtep_ef_tot_SOU[ce] # Attention, il faut corriger la part exo donn�e par Enerdata qui prend d�j� en compte le fonds chaleur, sinon double compte.  

phiy_ener[ce,se] = phiy_E[ce,se] / PhiY_E[ce]

PhiY_E[ce] = (sum(phiy_E[ce,se] on se))

verif_PhiY_ener[se] = 1 - (sum(phiy_ener[ce,se]] on se)) 

# avec Q_Mtep_FC le nombre de Mtep produites gr�ce au fonds chaleur cumul� sur la p�riode et dQ_Mtep_FC la production de nouvelles Mtep financ�e dans l'ann�e: 
#dQ_Mtep_FC[se24] est la production des reseaux de chaleur et dQ_Mtep_FC[se24,s] est la consommation des secteurs en chaleur renouvelable suite au changement de chaudi�re financ� par le FC. 

Q_Mtep_FC[se24] = Q_Mtep_FC[se24]{-1} + dQ_Mtep_FC[se24] + sum(dQ_Mtep_FC[se24,sne] on sne) where se24 in 2402 2403 2404 2405 2406

# on suppose que les Mtep d'ENR produites gr�ce au fonds chaleur se substituent au gaz naturel.

@over Q_Mtep_FC = sum(Q_Mtep_FC[se24] on se24) where se24 in 2402 2403 2404 2405 2406

@over dQ_Mtep_FC_2401 = -1 * Q_Mtep_FC

########## chronique d'investissement

#### la production Y s'ajuste � la demande (determinee par les PhiY_ener) et la demande de facteur K d�pend de Y. 
#### Si le ratio K/Y des secteurs correspondaient � celui des installations financ�es par le fonds chaleur, il ne serait pas n�cessaire de modifier l'�quation de demande du facteur capital.
#### c'est peu probable. Il faut s'assurer que les investissements suppl�mentaires entre AMS et AME soient sont du m�me montant que ceux financ�s par le fonds chaleur 

 K_nFC[se24]  = K_nFC[se24]{-1} *(1 + dlog(Y_nFC[se24])  + d(SUBST_K[se24])  - GR_PROG_K[se24]) 

 K_FC[se24] = K_FC[se24]{-1}*(1-tdec[se24]) + IA_FC[se24]

 Y_FC[se24] = (Q_Mtep_FC[se24]/Q_Mtep_ef_tot_24[se24]<1)* Q_Mtep_FC[se24]/Q_Mtep_ef_tot_24[se24] * Y[se24] + _ 
              (Q_Mtep_FC[se24]/Q_Mtep_ef_tot_24[se24]>=1)* 0.01* Y[se24] 
 
 Y_nFC[se24] = (Q_Mtep_FC[se24]/Q_Mtep_ef_tot_24[se24]<1)*(1- Q_Mtep_FC[se24]/Q_Mtep_ef_tot_24[se24]) * Y[se24]  + _
               (Q_Mtep_FC[se24]/Q_Mtep_ef_tot_24[se24]>=1)* 0.99 * Y[se24]
 
@over K[se24]  = K_FC[se24] + K_nFC[se24]
 
 @over K_n[se24]  = K[se24]


############chronique d'aide

# la subvention vers�e est �gale � un taux d'aide en euro courant par Mtep, multipli�e par le nombre de Mtep suppl�mentaires produites annuellement (les donn�es entre 2009 et 2023 sont en euros courants, on suppose que les taux d'aide seront index�s sur l'inflation au-del� de 2023).

SUB_FC[se24] = TSUB_FC[se24]* P/1.20 *dQ_Mtep_FC[se24]    # 1.21 est l'indice du prix en 2023

# pour simplifier l'aide est vers�e sous forme de cr�dit d'imp�t (on aurait pu activer SUB mais cette �quation n'est pas lue car il n'existait pas de subvention au secteur de la distribution de gaz � l'ann�e de base)

@over TAX_CR_VAL[se24] = SUB_FC[se24]  


############## Aides au CApex dans l'industrie et le services

dQ_Mtep_FC[sne] = sum(dQ_Mtep_FC[se,sne] on se)

# la subvention vers�e est �gale � un taux d'aide en euro courant par Mtep, multipli�e par le nombre de Mtep suppl�mentaires produites annuellement (les donn�es entre 2009 et 2023 sont en euros courants, on suppose que les taux d'aide seront index�s sur l'inflation au-del� de 2023).

SUB_FC[sind] = TSUB_FC[sind]*P/1.20 *dQ_Mtep_FC[sind] # 1.21 est l'indice du prix en 2023

# aussi pour les services
SUB_FC[s] = TSUB_FC[s]*P/1.20 *dQ_Mtep_FC[s] where s in 18 19 # 1.21 est l'indice du prix en 2023

# pour simplifier l'aide est vers�e sous forme de cr�dit d'imp�t 

@over TAX_CR_VAL[sind] = - T_TAX_CR[sind] * (d(E[sind]/YQ[sind])<=0) * PE[sind]*d(E[sind]/YQ[sind])*YQ[sind]{-1} + SUB_FC[sind]  
 
@over TAX_CR_VAL_19 = T_TAX_CR_19  * ( I_MDE_19 > 0 )  * PIA_13_19  * I_MDE_19 +  SUB_FC_19 

#il faut mettre un choc sur ia_n_des si on veut une hausse de l'investissement sans variation de la consommation �nerg�tique en Mtep


