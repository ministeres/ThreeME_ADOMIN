 dQ_Mtep_FC[s] := 0
 dQ_Mtep_FC[se,s] := 0
 
 dQ_Mtep_FCexo[s] := 0
 dQ_Mtep_FCexo[se,s] := 0
 
 Q_Mtep_FC[ce,s] := 0 *1 ^ (@year - %baseyear)
 
 SUB_FC[s] := TSUB_FC[s] * dQ_Mtep_FC[s]
 
 SUB_FC := sum(SUB_FC[s] on s)
 
 TSUB_FC[s] := 0
 
 @over IA_FC[s] :=0
 
 P_Mtep[se] := Y[se]/Q_Mtep_ef_tot[se]  if Q_Mtep_ef_tot[se] > 0 
 
 K_FC[se] :=0
 
 @over dQ_Mtep_FC[se,s] := 0
 
 K_nFC[se] :=K[se]
 
 PROG_Ap_K[se] * K[se] := Q_Mtep_ef_tot[se]* @elem(P_Mtep[se],%baseyear)
 
 PROG_Ap_K_nFC[se] * K_nFC[se] := (Q_Mtep_ef_tot[se]- Q_Mtep_FC[se]) * @elem(P_Mtep[se],%baseyear)
 
 PROG_Ap_I_nFC[se]  := PROG_Ap_K_nFC[se]
 
 #PROG_AP_I_FC[se]*(IA_FC[se]+ 0.0001) := dQ_Mtep_FC[se] * @elem(P_Mtep[se],%baseyear)
 
 PROG_AP_I_FC[se] := PROG_AP_I_nFC[se]
 
 K_A[se] := K[se]
 
 Y_nFC[se] :=Y[se] - Y_FC[se]
 
 Y_FC[se] := Q_Mtep_FC[se]*@elem(P_Mtep[se],%baseyear)
 
 SUBST_K_n_nFC[s] := SUBST_K_n[s]
         
 SUBST_K_n_FC[s] := SUBST_K_n[s]
 
 SUBST_K_FC[s] := SUBST_K[s]
 
 SUBST_K_nFC[s] := SUBST_K[s]
 
  PE_tot_nFC[s] := PE[s]+PE_Signal[s]+PE_CEE[s]+PE_signal_bis[s] 
  
  PE_tot_FC[s] :=  PE[s]+PE_Signal[s]+PE_CEE[s]+PE_signal_bis[s] + PE_signal_FC[s]   
  
  PE_Signal_FC[s] :=0 
  
 PE_Signal_FC[ce,s] :=0 
 
 SUBST_E_FC[ce,s]  := SUBST_E[ce,s]
 
 SUBST_E_nFC[ce,s]  := SUBST_E_FC[ce,s]
 
 SUBST_E_n_FC[ce,s] := SUBST_E_n[ce,s]
 
 SUBST_E_n_nFC[ce,s] := SUBST_E_n[ce,s]

  #-------------- correction CEE
  
  
  CEE :=0  
 
  CEE_VAL :=0
  
  SUB_CEE_VAL := CEE_VAL * (1 - part_frais_CEE)
 
  ## CEE versés au résidentiel
  
  R_SUB_renov[h,ecl,ecl2] := HOUSEHOLD_HYBRID_BUIL(228 + $ecl, $h)
  
  @over R_SUB[h,ecl,ecl2] := R_SUB_renov[h,ecl,ecl2] + R_SUB_CEE[h,ecl,ecl2]
  
  RENOV_VAL := (sum( sum(PREHAB_h01[ecl,ecl2] * REHAB_h01[ecl,ecl2] if REHAB_h01[ecl,ecl2] <> 0 on ecl2) on ecl))  
  
  RENOV_VAL[ecl] := sum(PREHAB_h01[ecl,ecl2] * REHAB_h01[ecl,ecl2] if REHAB_h01[ecl,ecl2] <> 0 on ecl2)   
    
  @over R_SUB_CEE[h,ecl,ecl2] * RENOV_VAL :=  SUB_CEE_VAL_resid
  
  CEE_VAL_resid := CEE_VAL * part_CEE_resid
  
  CEE_VAL_GD := CEE_VAL * part_CEE_GD
  
  CEE_VAL_hors_resid := CEE_VAL - CEE_VAL_resid
  
  SUB_CEE_VAL_resid := SUB_CEE_VAL * part_CEE_resid
  
  CEE_VAL_resid[se] := CEE_VAL_resid * Phi_CEE[se]
   
 @over DEP_VAL := CL_S[sp]*L_S[sp]*PROG_L[sp] + R_G{-1}*DEBT_G_VAL{-1} + PRESOC_VAL + SUB_RENOV_val + SUB_AUTO_VAL + REDIS_VAL_H _
                 + value(E[sp] + MAT[sp] + IY[sp] + IA[sp] + (G - G[sp]) - ((SUB - SUB_01) + (SY - SY_01))) 
                 
 R_SUB[ecl] * RENOV_VAL[ecl]  := sum(R_SUB_h01[ecl,ecl2] * PREHAB_h01[ecl,ecl2] * REHAB_h01[ecl,ecl2]  if REHAB_h01[ecl,ecl2] <> 0 on ecl2)     if  RENOV_VAL[ecl] > 0       
 
  R_SUB_renov[ecl] * RENOV_VAL[ecl]  := sum(R_SUB_renov_h01[ecl,ecl2] * PREHAB_h01[ecl,ecl2] * REHAB_h01[ecl,ecl2]  if REHAB_h01[ecl,ecl2] <> 0 on ecl2)    if  RENOV_VAL[ecl] > 0     
  
  Nu_REHAB[h,ecl] :=  Nu_REHABexo[h,ecl]
  
  Nu_REHABexo[h,ecl] := HOUSEHOLD_HYBRID_BUIL(206 + $ecl, $h)  
  
  @over SUB_RENOV_val[ecl] := R_SUB_renov[ecl] * RENOV_VAL[ecl]    where ecl in %list_ener_class\ CA
  
  SUB_RENOV_val := SUB_RENOV_val[CB] + SUB_RENOV_val[CC] + SUB_RENOV_val[CD] + SUB_RENOV_val[CE] + SUB_RENOV_val[CF] + SUB_RENOV_val[CG]
 
 
  ########## CEE versés aux secteurs
   
 @over part_frais_CEE  := 0.20 #hypothèse DGEC 10/03/2025
 part_CEE_resid := (@year<=2023)*1 + (@year>2023) * 0.632 #hypothèse DGEC 11/03/2025 63.2 %
  part_CEE_indus := 0 + (@year>2023) * (0.15+0.03) #hypothèse DGEC 11/03/2025 15% auquel on ajoute les 3% consacré au reseau de chaleur pour faire Un total de 100%
  part_CEE_ter := 0 + (@year>2023) * 0.132 #hypothèse DGEC 11/03/2025 13.2%
  part_CEE_trsp := 0 + (@year>2023) * 0.038 #hypothèse DGEC 11/03/2025 3.8%
  part_CEE_agri := 0 + (@year>2023) * 0.018 #hypothèse DGEC 11/03/2025 1.8%
  # reseaux 3,1%?
  
  # subventions de CEE recues par les secteurs de production
  
  part_CEE[sind] := part_CEE_indus * E_oth[sind]/E_Oth_sind_Sum
  E_Oth_sind_Sum := sum(E_oth[sind] on sind)
  part_CEE[ster] :=  part_CEE_ter * E_oth[ster]/E_Ster_Sum 
  E_Ster_Sum := sum(E_oth[ster] on ster) + sum(GD[ce] on ce)
  part_CEE[trsp] :=part_CEE_trsp * E_oth[trsp]/E_oth_trsp_Sum
  E_oth_trsp_Sum := sum(E_oth[trsp] on trsp)
  part_CEE_01 := part_CEE_agri 
  part_CEE_GD := part_CEE_ter * (sum(GD[ce] on ce))/E_Ster_Sum 
  
 SUB_CEE_VAL[sne] := SUB_CEE_VAL * part_CEE[sne]
 
 SUB_CEE_VAL_GD := SUB_CEE_VAL * part_CEE_GD 
 
 SUB_CEE_VAL_hors_resid := SUB_CEE_VAL - SUB_CEE_VAL_resid
 
 CEE_VAL_sec := CEE_VAL- CEE_VAL_resid - CEE_VAL_GD
 
 @over Y_ce[se] := sum(Y[ce,se] on ce)
 @over Y_ce := sum(Y_ce[se] on se)
 @over Phi_CEE[se] := Y_ce[se] / Y_ce
 @over PY_ce[se]*Y_ce[se] := sum(PY[se]*Y[ce,se] on ce) 
  
 CEE_VAL[se] := CEE_VAL  * Phi_CEE[se]
 CEE_VAL[ce,se] := CEE_VAL[se] * (PY[se]*Y[ce,se])/(PY_ce[se]*Y_ce[se]) if Y_ce[se]<>0
 CEE_VAL_ce[ce] := sum(CEE_VAL[ce,se] on se)
 
 Phi_CEE_ce[ce] := CEE_VAL_ce[ce] / (CEE_VAL + 0.0001)
 
 @over ED[ce] := sum(ED[ce,s] on s)
 
 @over EM[ce] := sum(EM[ce,s] on s)
 
 @over MAT_comm_CEE[se] := (CEE_VAL[se] * part_frais_CEE)/PY_19
 MAT_comm_CEE_VAL[se] := MAT_comm_CEE[se] *PY_19
 @over Phi_CEE[21] := 1 * QD[21] / (sum(QD[ce] on ce))   
 @over Phi_CEE[se22] := PhiY_ENER[22,se22] * QD[22] / (sum(QD[ce] on ce))   
 @over Phi_CEE[se23] := PhiY_ENER[23,se23] * QD[23] / (sum(QD[ce] on ce))   
 @over Phi_CEE[se24] := PhiY_ENER[24,se24] * QD[24] /(sum(QD[ce] on ce))   
 
  @over PE_CEE[s] := 0 #vu la modification des équations de K_E_des_n et E_oth_n, vu la modification des équations de PE, PCHD[ce] PGD[ce], on retranche l'effet CEE des équations Subst et CU
 
  
 @over phi_n_K[sne] := K_n[sne] * CK[sne] / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * PE[sne] + MAT_n[sne] * PMAT[sne])
 
 @over phi_n_L[sne] := L_n[sne] * PROG_L[sne] * CL[sne] / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * PE[sne] + MAT_n[sne] * PMAT[sne])
 
 @over phi_n_E[sne] := (E_n[sne] * PE[sne] ) / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * PE[sne] + MAT_n[sne] * PMAT[sne])
 
 @over phi_n_MAT[sne] := MAT_n[sne] * PMAT[sne] / (K_n[sne] * CK[sne] + L_n[sne] * PROG_L[sne] * CL[sne] + E_n[sne] * PE[sne] + MAT_n[sne] * PMAT[sne])
 
 @over phi_n_K[se] := K_n[se] * CK[se] / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * PE[se] + MAT_n[se] * PMAT[se])
 
 @over phi_n_L[se] := L_n[se] * PROG_L[se] * CL[se] / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * PE[se] + MAT_n[se] * PMAT[se])
 
 @over phi_n_E[se] := (E_n[se] * PE[se]) / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * PE[se] + MAT_n[se] * PMAT[se])
 
 @over phi_n_MAT[se] := MAT_n[se] * PMAT[se] / (K_n[se] * CK[se] + L_n[se] * PROG_L[se] * CL[se] + E_n[se] * PE[se] + MAT_n[se] * PMAT[se])
 
   ################################### option ADEME
   
  
  Var_K_E_CEE[sne]  := SUB_CEE_VAL[sne]/ PIA[sne]
       
  Var_E_oth_n_CEE[sne] := 0*1^(@year-%baseyear) # -Var_K_E_CEE[sne]*d(E_oth_n[sne]{-1})/I_MDE_n[sne]{-1} #cette spécification fait buger le modèle en AMS 2040
    
  Var_E_spe_CEE[road] := -Var_K_E_CEE[sne]*d(E_spe[road]){-1}/I_MDE_spe[road]{-1}
  
 NCU_ce[ce] * YQ[ce] := (sum(NCU_n[s]*Y[ce,s] if Y[ce,s]<>0 on s )) 
 
 CEE_VAL_ED[ce,s] :=  CEE_VAL_ce[ce]*CEE_ED_base[ce,s]/CEE_base[ce]
 
 CEE_VAL_ED[ce] :=sum(CEE_VAL_ED[ce,s] on s)
 
 CEE_VAL_CHD[ce] :=  CEE_VAL_ce[ce]*CHD[ce]/CEE_base[ce]
 
 CEE_VAL_GD[ce] := CEE_VAL_ce[ce]*GD[ce]/CEE_base[ce] 
 
 CU_CEE_VAL_ED[ce,s]  := CEE_VAL_ED[ce,s] /YQ[ce]
 
 CU_CEE_VAL_CHD[ce]  := CEE_VAL_CHD[ce]/YQ[ce]
 
 CU_CEE_VAL_GD[ce] := CEE_VAL_GD[ce]/YQ[ce] 
 
 CU_CEE_VAL_ce[ce] := CEE_VAL_ce[ce]/YQ[ce]
 
 CEE_base[ce] := CEE_ED_base[ce] + CHD[ce] + GD[ce]
 
 CEE_ED_base[ce] := sum(CEE_ED_base[ce,s] on s)
 
 CEE_ED_base[ce,s] := ED[ce,s] * (1- EXO_CEE_base[ce,s]) 
 
 EXO_CEE_base[ce,s] := 0
 
 @over EXO_CEE_base[ce,sind] := 1 
 
 @over EXO_CEE_base[ce,se] := 1 
  
 verif_CEE_cost:= CEE_VAl-CEE_VAL_CHD[ce]-CEE_VAL_GD[ce]-CEE_VAL_ED[ce]
 
 verif_phi_CEE := sum(Phi_CEE[se] on se) -1 
 
  VERIF_CEE := sum(CEE_VAL[se] on se) - CEE_VAL
  
  verif_CEE_ce := sum(CEE_VAL_ce[ce] on ce) - CEE_VAL
  
  @over R_SUB_CEE[sne] := 0
    
  @over PK_E[sne]  := PK[sne] 
 
  @over PK_NE[sne]  := PK[sne] 
   
  @over CK_E[sne] := CK[sne] 
   
  @over CK_NE[sne] := CK[sne] 
  
  CK_E_m[s] := CK[s]
   
  CK_NE_m[s] := CK[s]
    
  CK_m[s] := CK[s] 
    


